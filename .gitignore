functions/.smoke/

# Event demo video (Remotion). Netlify publishes ".", so the video project's
# node_modules and render artifacts must never enter git or a deploy.
video/node_modules/
video/out/
video/recordings/
video/public/recordings/

# Generated by scripts/build-rules.js — the comment-stripped rules that actually
# deploy. firestore.rules is the source of truth and the only file anyone edits.
.rules-build/

# Illustration SOURCES for the diner app. The page loads the .webp twins beside
# them — 4MB of PNG became 40KB — and `assets/images/` ships wholesale to three
# Netlify sites, so committing the originals would put 4MB on the wire that no
# page ever requests. Kept on disk as the editable master; regenerate the webp
# at 420px/q0.82 if one is re-exported.
assets/images/cooked.png
assets/images/served.png
assets/images/payment.png
assets/images/emptychart.png
assets/images/storeclose.png
# Also a master now: the success sheet loads order-success.webp (4KB); the
# re-exported PNG is 941KB and must not ride on every deploy.
assets/images/order-success.png

# Lunch Rush load-test outputs (perf/seed.js): tokens, cards, run data
perf/.fixtures.json
perf/out/

# Cloud Run bundle for the QR diner functions (scripts/build-qr-service.js)
.qr-service/
