rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidBaseRecord(data) {
      return data.keys().hasAll([
          'amount',
          'vendor_name',
          'category',
          'type',
          'status',
          'icon',
          'timestamp'
        ])
        && data.amount is number
        && data.amount > 0
        && data.amount <= 999999999999
        && data.vendor_name is string
        && data.vendor_name.size() > 0
        && data.vendor_name.size() <= 160
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.type is string
        && data.type.size() > 0
        && data.type.size() <= 40
        && data.status in ['Completed', 'Missing Receipt', 'Pending', 'Upcoming', 'Reconciled', 'Cancelled']
        && data.icon is string
        && data.icon.size() <= 16
        && data.timestamp is timestamp;
    }

    function isValidBaseRecordUpdate(data, existingData) {
      return data.keys().hasAll([
          'amount',
          'vendor_name',
          'category',
          'type',
          'status',
          'icon',
          'timestamp'
        ])
        && data.amount is number
        && data.amount > 0
        && data.amount <= 999999999999
        && data.vendor_name is string
        && data.vendor_name.size() > 0
        && data.vendor_name.size() <= 160
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.type is string
        && data.type.size() > 0
        && data.type.size() <= 40
        && data.status in ['Completed', 'Missing Receipt', 'Pending', 'Upcoming', 'Reconciled', 'Cancelled']
        && data.icon is string
        && data.icon.size() <= 16
        && data.timestamp == existingData.timestamp;
    }

    function isValidTransactionRecordUpdate(data, existingData) {
      return data.keys().hasAll([
          'amount',
          'vendor_name',
          'category',
          'type',
          'status',
          'icon',
          'timestamp'
        ])
        && data.amount is number
        && data.amount > 0
        && data.amount <= 999999999999
        && data.vendor_name is string
        && data.vendor_name.size() > 0
        && data.vendor_name.size() <= 160
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.type is string
        && data.type.size() > 0
        && data.type.size() <= 40
        && data.status in ['Completed', 'Missing Receipt', 'Pending', 'Upcoming', 'Reconciled', 'Cancelled', 'Voided']
        && data.icon is string
        && data.icon.size() <= 16
        && data.timestamp is timestamp
        && (!('created_at' in data) || data.created_at == existingData.created_at)
        && (!('updated_at' in data) || data.updated_at == request.time)
        && (!('updated_by' in data) || data.updated_by == request.auth.uid)
        && (!('is_voided' in data) || data.is_voided is bool)
        && (!('voided_at' in data) || data.voided_at == request.time)
        && (!('voided_by' in data) || data.voided_by == request.auth.uid)
        && (!('void_reason' in data) || (data.void_reason is string && data.void_reason.size() > 0 && data.void_reason.size() <= 500))
        && (!(data.status == 'Voided') || (
          data.is_voided == true
          && data.voided_at == request.time
          && data.voided_by == request.auth.uid
          && data.void_reason is string
          && data.void_reason.size() > 0
          && data.void_reason.size() <= 500
        ));
    }

    // Despite the name this enum is "how did this row get here", and already
    // carries two non-AI values. 'pos' is here because the till writes from the
    // CLIENT and must pass rules — commerce sets source:'commerce' and is absent
    // only because its writer is the Admin SDK, which bypasses rules entirely.
    // `source` is load-bearing: selectRule reads it to choose POS-SALE.
    function isValidAICaptureMetadata(data) {
      return (!('source' in data) || data.source in ['bill_scan', 'transaction_scan', 'subscription_scan', 'bank_statement_import', 'csv_import', 'pos'])
        && (!('created_via' in data) || data.created_via in ['ai_bill_capture', 'ai_transaction_capture', 'ai_subscription_capture'])
        && (!('extraction_status' in data) || data.extraction_status == 'reviewed')
        && (!('extraction_source' in data) || data.extraction_source is string)
        && (!('extraction_confidence' in data) || data.extraction_confidence == null || data.extraction_confidence is number)
        && (!('extraction_warnings' in data) || data.extraction_warnings is list)
        && (!('document_type' in data) || data.document_type is string)
        && (!('invoice_number' in data) || data.invoice_number == null || data.invoice_number is string)
        && (!('invoice_date' in data) || data.invoice_date is timestamp)
        && (!('raw_text_preview' in data) || data.raw_text_preview == null || (data.raw_text_preview is string && data.raw_text_preview.size() <= 500))
        && (!('source_file_name' in data) || data.source_file_name == null || data.source_file_name is string)
        && (!('source_file_mime_type' in data) || data.source_file_mime_type == null || data.source_file_mime_type is string)
        && (!('source_file_size_bytes' in data) || data.source_file_size_bytes == null || data.source_file_size_bytes is number)
        && (!('payment_reference' in data) || data.payment_reference == null || data.payment_reference is string)
        && (!('notes' in data) || data.notes == null || data.notes is string)
        && (!('billing_cycle' in data) || data.billing_cycle in ['monthly', 'annual', 'weekly', 'quarterly', 'unknown'])
        && (!('bank_statement_import_id' in data) || data.bank_statement_import_id is string)
        && (!('bank_statement_row_id' in data) || data.bank_statement_row_id is string)
        && (!('imported_at' in data) || data.imported_at == null || data.imported_at is timestamp)
        && (!('bank_account_id' in data) || data.bank_account_id == null || data.bank_account_id is string);
    }

    // Duplicate prevention (docs/DUPLICATE_PREVENTION.md) — the record of what a
    // user decided about one flagged pair of records. Ids, an integer score, and
    // enums only: no money, no vendor names, no formatted currency. Deliberately
    // 13 keys with a flat validator, to stay well inside the rules evaluation
    // budget that the invoice transitions already brush against.
    function isValidDuplicateReview(data) {
      return data.keys().hasOnly([
          'kind', 'primary_id', 'duplicate_id', 'score', 'rules', 'decision',
          'reason', 'source', 'notes', 'decided_by', 'decided_at', 'created_at'
        ])
        && data.keys().hasAll(['kind', 'primary_id', 'decision', 'source', 'decided_by', 'created_at'])
        && data.kind in ['transactions', 'bills', 'invoices', 'subscriptions', 'journals']
        && data.primary_id is string && data.primary_id.size() <= 160
        && (!('duplicate_id' in data) || (data.duplicate_id is string && data.duplicate_id.size() <= 160))
        && (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 100))
        && (!('rules' in data) || (data.rules is list && data.rules.size() <= 8))
        && data.decision in ['pending', 'kept_both', 'ignored', 'valid', 'voided', 'reversed', 'merged', 'attached']
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.source in ['manual', 'scan', 'csv', 'bank_sync', 'revenue_sync', 'api', 'cleanup']
        && data.decided_by == request.auth.uid
        && data.created_at == request.time;
    }

    // Amending a decision: the pair it describes is immutable, only the outcome
    // and its narrative can change (resolve a `pending`, add a note).
    function isValidDuplicateReviewUpdate(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly(['decision', 'reason', 'notes', 'decided_by', 'decided_at'])
        && data.decision in ['pending', 'kept_both', 'ignored', 'valid', 'voided', 'reversed', 'merged', 'attached']
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.decided_by == request.auth.uid;
    }


    // Internal-console outreach leads (Sales Leads → Outreach subpage). Manually
    // entered prospects the team sends the bilingual meeting-reminder to.
    // MVP_INTERNAL_ONLY_TEMPORARY — open + field-validated like internal_digest_jobs;
    // the actual email send is gated by the send-lead-outreach function token.
    function isValidOutreachLead(data) {
      return data.keys().hasOnly([
          'name', 'gender', 'email', 'role', 'company', 'meeting_at',
          'status', 'last_sent_at', 'created_at', 'updated_at'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.gender in ['male', 'female']
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.status in ['new', 'sent', 'meeting_booked', 'closed']
        && data.meeting_at is timestamp
        && (!('role' in data) || (data.role is string && data.role.size() <= 120))
        && (!('company' in data) || (data.company is string && data.company.size() <= 160))
        && (!('last_sent_at' in data) || data.last_sent_at is timestamp)
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    // Accounting Center (Phase 1) — saved category/type → account mappings.
    // Strings/enums only. No money, no row-level financial data, no formatted
    // currency. See docs/PROJECT_BACKGROUND.md §4 (Accounting mappings).
    function isValidAccountingMapping(data) {
      return data.keys().hasOnly([
          'source_type',
          'source_value',
          'target_account_code',
          'target_account_name',
          'target_account_type',
          'confidence',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasAll([
          'source_type',
          'source_value',
          'target_account_code',
          'target_account_name',
          'target_account_type',
          'confidence',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.source_type in ['transaction_category', 'transaction_type', 'vendor', 'keyword']
        && data.source_value is string
        && data.source_value.size() > 0
        && data.source_value.size() <= 60
        && data.target_account_code is string
        && data.target_account_code.size() > 0
        && data.target_account_code.size() <= 12
        && data.target_account_name is string
        && data.target_account_name.size() > 0
        && data.target_account_name.size() <= 80
        && data.target_account_type in ['asset', 'liability', 'equity', 'revenue', 'expense', 'contra_revenue', 'contra_expense']
        && data.confidence in ['system_default', 'user_confirmed', 'ai_suggested']
        && data.status in ['active', 'archived'];
    }

    function isValidAccountingMappingCreate(data) {
      return isValidAccountingMapping(data)
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function isValidAccountingMappingUpdate(data, existingData) {
      return isValidAccountingMapping(data)
        && data.source_type == existingData.source_type
        && data.source_value == existingData.source_value
        && data.created_at == existingData.created_at
        && data.updated_at == request.time;
    }

    // NOTE: isValidBillingAccess / isValidPaymentVerification lived here and were
    // removed 2026-08-16. They validated client writes to users/{uid}/billing/*
    // and users/{uid}/payment_verifications/*, but both collections are
    // `allow create, update, delete: if false` — server-only through the Admin
    // SDK, which bypasses rules. So the validators had no reachable call path,
    // and the rules compiler flagged them as unused. The CLI treats that as a
    // warning; the Firebase console treats it as a hard error and refuses to
    // publish the whole file, which is how they came to block a deploy.

    function isValidBillingPlan(planId) {
      return planId in ['trial', 'starter', 'core', 'growth', 'enterprise'];
    }

    function isValidBillingPlanName(planId, planName) {
      return (planId == 'trial' && planName == 'Trial')
        || (planId == 'starter' && planName == 'Starter')
        || (planId == 'core' && planName == 'Core Ops')
        || (planId == 'growth' && planName == 'Growth Engine')
        || (planId == 'enterprise' && planName == 'Enterprise AI');
    }

    // Voucher discount snapshot on a payment request. The fields are optional
    // (old cached clients omit them); absent/null means no voucher. When a
    // voucher IS applied, hasValidPaymentRequestVoucher() re-derives every
    // value from the canonical voucher doc, so this helper alone is never
    // trusted for a discount.
    function voucherDiscountOf(data) {
      return ('voucher_discount_amount' in data) && data.voucher_discount_amount != null
        ? data.voucher_discount_amount
        : 0;
    }

    // Subtotals for every (currency, plan, frequency) FluxyOS sells, mirroring
    // PLAN_PRICES in assets/js/billing-config.js. Amounts are integer MINOR units
    // — IDR minorPerUnit 1, PHP 100 (centavos).
    //
    // A map lookup rather than an OR-chain of equality clauses: adding the second
    // currency would otherwise have doubled a 6-clause chain, and this ruleset is
    // already near the expression-complexity ceiling (docs note, 2026-08-21).
    // Unknown combinations return -1, which no valid subtotal can equal.
    function billingSubtotal(data) {
      return {
        'IDR|starter|monthly': 1290000, 'IDR|starter|annually': 11880000,
        'IDR|core|monthly':    3490000, 'IDR|core|annually':    33480000,
        'IDR|growth|monthly':  6990000, 'IDR|growth|annually':  67080000,
        'PHP|starter|monthly':  449000, 'PHP|starter|annually':  4188000,
        'PHP|core|monthly':    1219000, 'PHP|core|annually':    11748000,
        'PHP|growth|monthly':  2449000, 'PHP|growth|annually':  23508000
      }.get(data.currency + '|' + data.plan_id + '|' + data.billing_frequency, -1);
    }

    // Sales tax on the subscription itself: Indonesia PPN 11%, Philippines VAT
    // 12% on digital services. Mirrors BILLING_TAX in billing-config.js.
    function billingTaxRate(currency) {
      return {'IDR': 11, 'PHP': 12}.get(currency, -1);
    }

    function isValidBillingAmounts(data) {
      // Tax applies to the voucher-discounted subtotal. Every price in the book
      // is a multiple of 1000 minor units and discounts are integer percents, so
      // the integer math is exact (no truncation) and matches the client.
      return data.subtotal_amount == billingSubtotal(data)
        && data.estimated_tax_amount ==
             (data.subtotal_amount - voucherDiscountOf(data)) * billingTaxRate(data.currency) / 100;
    }

    function isValidBillingFrequency(frequency) {
      return frequency == null || frequency in ['monthly', 'annually'];
    }

    function isValidBillingSubscription(data) {
      return data.keys().hasAll([
          'plan_id',
          'plan_name',
          'status',
          'billing_frequency',
          'current_payment_request_id',
          'trial_started_at',
          'trial_ends_at',
          'current_period_start',
          'current_period_end',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'plan_id',
          'plan_name',
          'status',
          'billing_frequency',
          'current_payment_request_id',
          'trial_started_at',
          'trial_ends_at',
          'current_period_start',
          'current_period_end',
          'updated_at'
        ])
        && isValidBillingPlan(data.plan_id)
        && isValidBillingPlanName(data.plan_id, data.plan_name)
        && data.status in ['trialing', 'awaiting_payment', 'pending_verification', 'active', 'cancel_scheduled', 'past_due', 'expired', 'payment_failed']
        && isValidBillingFrequency(data.billing_frequency)
        && (data.current_payment_request_id == null || (data.current_payment_request_id is string && data.current_payment_request_id.size() <= 160))
        && (data.trial_started_at == null || data.trial_started_at is timestamp)
        && (data.trial_ends_at == null || data.trial_ends_at is timestamp)
        && (data.current_period_start == null || data.current_period_start is timestamp)
        && (data.current_period_end == null || data.current_period_end is timestamp)
        && data.updated_at == request.time;
    }

    function isValidBillingPaymentRequest(data) {
      return data.keys().hasAll([
          'plan_id',
          'plan_name',
          'billing_frequency',
          'subtotal_amount',
          'estimated_tax_amount',
          'total_amount',
          'currency',
          'payment_method',
          'payment_status',
          'provider',
          'provider_payment_id',
          'provider_invoice_url',
          'submitted_at',
          'verified_at',
          'failed_at',
          'expires_at',
          'user_confirmed_payment_at',
          'submitted_for_verification_at',
          'proof_document_id',
          'proof_file_name',
          'proof_uploaded_at',
          'created_at',
          'updated_at',
          'prev_plan_id',
          'prev_plan_name',
          'prev_status',
          'prev_billing_frequency'
        ])
        // Voucher snapshot fields are allowed but NOT required (hasOnly, not
        // hasAll) so pre-voucher cached clients keep working. The new client
        // always writes all four (null when no voucher is applied).
        && data.keys().hasOnly([
          'plan_id',
          'plan_name',
          'billing_frequency',
          'subtotal_amount',
          'estimated_tax_amount',
          'total_amount',
          'currency',
          'payment_method',
          'payment_status',
          'provider',
          'provider_payment_id',
          'provider_invoice_url',
          'submitted_at',
          'verified_at',
          'failed_at',
          'expires_at',
          'user_confirmed_payment_at',
          'submitted_for_verification_at',
          'proof_document_id',
          'proof_file_name',
          'proof_uploaded_at',
          'created_at',
          'updated_at',
          'prev_plan_id',
          'prev_plan_name',
          'prev_status',
          'prev_billing_frequency',
          'voucher_id',
          'voucher_code',
          'voucher_discount_percent',
          'voucher_discount_amount'
        ])
        && data.plan_id in ['starter', 'core', 'growth', 'enterprise']
        && isValidBillingPlanName(data.plan_id, data.plan_name)
        && data.billing_frequency in ['monthly', 'annually']
        && data.subtotal_amount is number
        && data.subtotal_amount > 0
        && data.estimated_tax_amount is number
        && data.estimated_tax_amount >= 0
        && data.total_amount is number
        && data.total_amount == data.subtotal_amount - voucherDiscountOf(data) + data.estimated_tax_amount
        && isValidBillingAmounts(data)
        && data.currency in ['IDR', 'PHP']
        // QRIS is an Indonesian rail; a PH customer pays by bank transfer.
        && data.payment_method in ['qris', 'va', 'card', 'invoice', 'bank_transfer']
        // QRIS starts as awaiting_payment (pay the QR first); other methods submit
        // for verification immediately. verified/failed/expired stay server-owned.
        && data.payment_status in ['awaiting_payment', 'pending_verification']
        && data.provider == 'manual'
        && data.provider_payment_id == null
        && data.provider_invoice_url == null
        && data.submitted_at == request.time
        && data.verified_at == null
        && data.failed_at == null
        && data.expires_at == null
        && data.user_confirmed_payment_at == null
        && data.submitted_for_verification_at == null
        && data.proof_document_id == null
        && data.proof_file_name == null
        && data.proof_uploaded_at == null
        && data.created_at == request.time
        && data.updated_at == request.time
        // Prior-subscription snapshot (used to safely restore state on cancel).
        && (data.prev_plan_id == null || data.prev_plan_id in ['trial', 'starter', 'core', 'growth', 'enterprise'])
        && (data.prev_plan_name == null || (data.prev_plan_name is string && data.prev_plan_name.size() <= 60))
        && (data.prev_status == null || data.prev_status in ['trialing', 'awaiting_payment', 'pending_verification', 'active', 'past_due', 'expired', 'payment_failed'])
        && (data.prev_billing_frequency == null || data.prev_billing_frequency in ['monthly', 'annually']);
    }

    // The prior-subscription snapshot stored on a new payment request must mirror
    // the user's ACTUAL subscription at creation time (read pre-batch via get()),
    // so it can never be forged to later restore an elevated/unpaid plan on cancel.
    function hasValidPaymentRequestPrevSnapshot(userId, data) {
      return (
          !exists(/databases/$(database)/documents/users/$(userId)/billing_subscription/current)
          && data.prev_plan_id == null
          && data.prev_plan_name == null
          && data.prev_status == null
          && data.prev_billing_frequency == null
        ) || (
          exists(/databases/$(database)/documents/users/$(userId)/billing_subscription/current)
          && data.prev_plan_id == get(/databases/$(database)/documents/users/$(userId)/billing_subscription/current).data.plan_id
          && data.prev_plan_name == get(/databases/$(database)/documents/users/$(userId)/billing_subscription/current).data.plan_name
          && data.prev_status == get(/databases/$(database)/documents/users/$(userId)/billing_subscription/current).data.status
          && data.prev_billing_frequency == get(/databases/$(database)/documents/users/$(userId)/billing_subscription/current).data.billing_frequency
        );
    }

    // True when the payment request carries no voucher at all (fields absent
    // for pre-voucher cached clients, or all-null for the current client).
    // Mixed null/non-null voucher fields fail both this and the applied branch.
    function hasNoVoucherFields(data) {
      return (!('voucher_id' in data) || data.voucher_id == null)
        && (!('voucher_code' in data) || data.voucher_code == null)
        && (!('voucher_discount_percent' in data) || data.voucher_discount_percent == null)
        && (!('voucher_discount_amount' in data) || data.voucher_discount_amount == null);
    }

    // Server-enforced voucher redemption. The discount on a payment request is
    // only accepted when, in the SAME commit:
    //   1. the canonical voucher doc (voucher_codes/{CODE}, read pre-commit via
    //      get()) is active, inside its validity window, allows the selected
    //      plan + billing frequency, and still has redemption slots left;
    //   2. the snapshot percent equals the voucher's discount_value and the
    //      discount amount is recomputed here (subtotal * percent / 100 —
    //      integer-exact, see isValidBillingAmounts);
    //   3. the voucher's redemption_count is incremented by exactly 1
    //      (checked via getAfter against the pre-commit value); and
    //   4. a voucher_redemptions/{paymentRequestId} doc for this user + voucher
    //      is created in the same commit (its own create rule mirrors the
    //      amounts back against this payment request via getAfter).
    // A client editing browser JS cannot forge any of these: the rules engine
    // recomputes the price from the voucher doc it reads itself.
    function hasValidPaymentRequestVoucher(userId, requestId, data) {
      return hasNoVoucherFields(data)
        || hasAppliedPaymentRequestVoucher(userId, requestId, data);
    }

    // `let` bindings keep the expression count low (rules evaluate at most
    // 1000 expressions per request; repeating the full get() path in every
    // condition blows that budget on this already-large create rule). A null
    // voucher_id or missing voucher doc makes the binding error → deny, which
    // is the correct outcome for mixed-null fields or unknown codes.
    function hasAppliedPaymentRequestVoucher(userId, requestId, data) {
      let voucher = get(/databases/$(database)/documents/voucher_codes/$(data.voucher_id)).data;
      let voucherAfter = getAfter(/databases/$(database)/documents/voucher_codes/$(data.voucher_id)).data;
      let redemptionAfter = getAfter(/databases/$(database)/documents/voucher_redemptions/$(requestId)).data;
      return data.voucher_id is string
        && data.voucher_id.matches('^[A-Z0-9_-]{4,32}$')
        && data.voucher_code == data.voucher_id
        && data.voucher_discount_percent is int
        && data.voucher_discount_percent >= 1
        && data.voucher_discount_percent <= 100
        && voucher.status == 'active'
        && voucher.discount_type == 'percentage'
        && data.voucher_discount_percent == voucher.discount_value
        && data.voucher_discount_amount == data.subtotal_amount * data.voucher_discount_percent / 100
        && (voucher.valid_from == null || voucher.valid_from <= request.time)
        && (voucher.valid_until == null || voucher.valid_until >= request.time)
        && (voucher.allowed_plan_ids == null || data.plan_id in voucher.allowed_plan_ids)
        && (voucher.allowed_billing_frequencies == null || data.billing_frequency in voucher.allowed_billing_frequencies)
        && (voucher.max_redemptions == null || voucher.redemption_count < voucher.max_redemptions)
        && voucherAfter.redemption_count == voucher.redemption_count + 1
        && redemptionAfter.user_id == userId
        && redemptionAfter.voucher_id == data.voucher_id;
    }

    // Owner-driven transition: a QRIS request moves awaiting_payment ->
    // pending_verification after the user confirms payment. Only the lifecycle
    // + optional proof-reference fields may change; amounts/plan/method are
    // immutable (guaranteed by the affectedKeys allow-list). The client can
    // never write verified/failed/expired here.
    function isValidPaymentRequestVerificationSubmit(prev, next) {
      return prev.payment_status == 'awaiting_payment'
        && next.payment_status == 'pending_verification'
        && next.diff(prev).affectedKeys().hasOnly([
          'payment_status',
          'user_confirmed_payment_at',
          'submitted_for_verification_at',
          'proof_document_id',
          'proof_file_name',
          'proof_uploaded_at',
          'updated_at'
        ])
        && next.user_confirmed_payment_at is timestamp
        && next.submitted_for_verification_at == request.time
        && next.updated_at == request.time
        && (
          (next.proof_document_id == null && next.proof_file_name == null && next.proof_uploaded_at == null)
          || (next.proof_document_id is string && next.proof_document_id.size() <= 160
            && next.proof_file_name is string && next.proof_file_name.size() <= 240
            && next.proof_uploaded_at is timestamp)
        );
    }

    // Owner-driven cancel: an in-flight QRIS request moves
    // awaiting_payment|pending_verification -> canceled. Only the lifecycle
    // status + updated_at may change; amounts/plan/method stay immutable
    // (guaranteed by the affectedKeys allow-list). verified/failed/expired stay
    // server-owned and can never be set here.
    function isValidPaymentRequestCancel(prev, next) {
      return (prev.payment_status == 'awaiting_payment' || prev.payment_status == 'pending_verification')
        && next.payment_status == 'canceled'
        && next.diff(prev).affectedKeys().hasOnly([
          'payment_status',
          'updated_at'
        ])
        && next.updated_at == request.time;
    }

    function isCheckoutSubscriptionWrite(userId, data) {
      return data.status == 'pending_verification'
        && data.plan_id in ['starter', 'core', 'growth', 'enterprise']
        && data.billing_frequency in ['monthly', 'annually']
        && data.current_payment_request_id is string
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(data.current_payment_request_id)).data.plan_id == data.plan_id
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(data.current_payment_request_id)).data.billing_frequency == data.billing_frequency
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(data.current_payment_request_id)).data.payment_status == 'pending_verification';
    }

    function hasRecentBillingPeriodStart(data) {
      return data.current_period_start is timestamp
        && data.current_period_start <= request.time
        && data.current_period_start >= request.time - duration.value(10, 'm');
    }

    function hasInternalVerifiedBillingPeriodStart(userId, data) {
      return get(/databases/$(database)/documents/internal_users/$(userId)).data.payment_verified_at is timestamp
        && data.current_period_start == get(/databases/$(database)/documents/internal_users/$(userId)).data.payment_verified_at;
    }

    function hasValidBillingPeriodWindow(data) {
      return data.current_period_start is timestamp
        && data.current_period_end is timestamp
        && data.current_period_end > data.current_period_start
        && (
          (data.billing_frequency == 'monthly'
            && data.current_period_end <= data.current_period_start + duration.value(32, 'd'))
          || (data.billing_frequency == 'annually'
            && data.current_period_end >= data.current_period_start + duration.value(360, 'd')
            && data.current_period_end <= data.current_period_start + duration.value(367, 'd'))
        );
    }

    function hasValidVerifiedBillingPeriod(userId, data) {
      return hasValidBillingPeriodWindow(data)
        && (hasInternalVerifiedBillingPeriodStart(userId, data) || hasRecentBillingPeriodStart(data));
    }

    function hasValidActiveReconcileFields(userId, prev, data) {
      return data.diff(prev).affectedKeys().hasOnly(['status', 'updated_at'])
        || (data.diff(prev).affectedKeys().hasOnly(['status', 'current_period_start', 'current_period_end', 'updated_at'])
          && prev.current_period_end == null
          && hasValidVerifiedBillingPeriod(userId, data));
    }

    // Owner carries a reviewer's verify/reject decision from the open
    // internal_users index into their canonical subscription. Verified payments
    // may also stamp current_period_start/current_period_end from the verified
    // billing frequency so settings can show the next billing date.
    // MVP/UX-only: internal_users is the credential-gated ops index; a trusted
    // backend should own this in production.
    function isInternalReviewReconcile(userId, prev, data) {
      return exists(/databases/$(database)/documents/internal_users/$(userId))
        && (
          // A verified payment is a definitive grant: promote to active from any
          // not-yet-active state (incl. expired/trialing). No updated_at race —
          // the automatic trial-expiry write bumps prev.updated_at after the
          // manual review, which must not strand an approved user.
          (data.status == 'active'
            && prev.status in ['pending_verification', 'awaiting_payment', 'expired', 'trialing']
            && hasValidActiveReconcileFields(userId, prev, data)
            && get(/databases/$(database)/documents/internal_users/$(userId)).data.payment_status == 'verified')
          // Rejection only fails an in-flight payment and must be newer than the
          // subscription's own last write (never clobber a fresh retry).
          || (data.status == 'payment_failed'
            && data.diff(prev).affectedKeys().hasOnly(['status', 'updated_at'])
            && (prev.status == 'pending_verification' || prev.status == 'awaiting_payment')
            && get(/databases/$(database)/documents/internal_users/$(userId)).data.updated_at > prev.updated_at
            && get(/databases/$(database)/documents/internal_users/$(userId)).data.payment_status == 'rejected')
        );
    }

    function isActiveBillingPeriodBackfill(userId, prev, data) {
      return exists(/databases/$(database)/documents/internal_users/$(userId))
        && prev.status == 'active'
        && data.status == 'active'
        && prev.current_period_end == null
        && get(/databases/$(database)/documents/internal_users/$(userId)).data.payment_status == 'verified'
        && data.diff(prev).affectedKeys().hasOnly(['current_period_start', 'current_period_end', 'updated_at'])
        && hasValidVerifiedBillingPeriod(userId, data);
    }

    // QRIS checkout: subscription moves to awaiting_payment alongside an
    // awaiting_payment request (cross-checked in the same commit).
    function isCheckoutAwaitingPaymentWrite(userId, data) {
      return data.status == 'awaiting_payment'
        && data.plan_id in ['starter', 'core', 'growth', 'enterprise']
        && data.billing_frequency in ['monthly', 'annually']
        && data.current_payment_request_id is string
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(data.current_payment_request_id)).data.plan_id == data.plan_id
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(data.current_payment_request_id)).data.billing_frequency == data.billing_frequency
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(data.current_payment_request_id)).data.payment_status == 'awaiting_payment';
    }

    // Owner cancels an in-flight payment: the subscription reverts from
    // awaiting_payment|pending_verification back to its trial state (trialing if
    // the trial is still live, expired if it already lapsed), dropping the
    // unpaid plan and clearing the payment request link. Cross-checked against
    // the linked request being canceled in the SAME commit, so access can never
    // silently revert to trial without the request actually being voided.
    function isCancelPaymentRevert(userId, prev, data) {
      return (prev.status == 'awaiting_payment' || prev.status == 'pending_verification')
        && prev.current_payment_request_id is string
        && data.plan_id == 'trial'
        && data.plan_name == 'Trial'
        && data.billing_frequency == null
        && data.current_payment_request_id == null
        && data.current_period_start == null
        && data.current_period_end == null
        && data.trial_started_at == prev.trial_started_at
        && data.trial_ends_at == prev.trial_ends_at
        && (
          (data.status == 'trialing' && (prev.trial_ends_at == null || prev.trial_ends_at >= request.time))
          || (data.status == 'expired' && prev.trial_ends_at is timestamp && prev.trial_ends_at < request.time)
        )
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(prev.current_payment_request_id)).data.payment_status == 'canceled';
    }

    // Owner cancels an in-flight payment that was started while ALREADY on a paid
    // plan (e.g. an upgrade attempt): the subscription is restored to that prior
    // active plan rather than dropped to trial. The restored plan/frequency must
    // match the snapshot captured on the canceled request (which itself was bound
    // to the real prior subscription at create time), the billing period is
    // preserved unchanged and must be a valid window, and the linked request must
    // be canceled in the same commit. This grants 'active' only when the user
    // genuinely held it — never an escalation.
    function isCancelRestoreActive(userId, prev, data) {
      return (prev.status == 'awaiting_payment' || prev.status == 'pending_verification')
        && prev.current_payment_request_id is string
        && data.status == 'active'
        && data.plan_id in ['starter', 'core', 'growth', 'enterprise']
        && data.billing_frequency in ['monthly', 'annually']
        && data.current_payment_request_id == null
        && data.trial_started_at == prev.trial_started_at
        && data.trial_ends_at == prev.trial_ends_at
        && data.current_period_start == prev.current_period_start
        && data.current_period_end == prev.current_period_end
        && (
          (data.current_period_start == null && data.current_period_end == null)
          || hasValidBillingPeriodWindow(data)
        )
        && data.plan_id == getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(prev.current_payment_request_id)).data.prev_plan_id
        && data.plan_name == getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(prev.current_payment_request_id)).data.prev_plan_name
        && data.billing_frequency == getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(prev.current_payment_request_id)).data.prev_billing_frequency
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(prev.current_payment_request_id)).data.prev_status == 'active'
        && getAfter(/databases/$(database)/documents/users/$(userId)/billing_payment_requests/$(prev.current_payment_request_id)).data.payment_status == 'canceled';
    }

    // Owner cancels renewal on an active subscription: status moves
    // active -> cancel_scheduled (access kept until period end). Reactivate is the
    // inverse (cancel_scheduled -> active). Only the lifecycle status changes, and
    // neither is an escalation — the user already holds the paid entitlement.
    function isCancelRenewalWrite(prev, data) {
      return prev.status == 'active'
        && data.status == 'cancel_scheduled'
        && data.diff(prev).affectedKeys().hasOnly(['status', 'updated_at'])
        && data.updated_at == request.time;
    }

    function isReactivateRenewalWrite(prev, data) {
      return prev.status == 'cancel_scheduled'
        && data.status == 'active'
        && data.diff(prev).affectedKeys().hasOnly(['status', 'updated_at'])
        && data.updated_at == request.time;
    }

    // A KYC-enforced user (post-cutoff signup, flagged on onboarding/progress at
    // submit time) may not mint a trial until a reviewer has approved them in the
    // open internal_users index. Legacy users carry no flag and are unaffected.
    // Same MVP posture as isInternalReviewReconcile above: internal_users is the
    // credential-gated ops index, and a trusted backend should own this in
    // production.
    function passesKycTrialGate(progress) {
      return progress.get('kyc_enforced', false) != true
        || (exists(/databases/$(database)/documents/internal_users/$(request.auth.uid))
          && get(/databases/$(database)/documents/internal_users/$(request.auth.uid)).data.kyc_status == 'approved');
    }

    function isTrialSubscriptionCreate(data) {
      return data.status == 'trialing'
        && data.plan_id == 'trial'
        && data.plan_name == 'Trial'
        && data.billing_frequency == null
        && data.current_payment_request_id == null
        && data.trial_started_at is timestamp
        && data.trial_ends_at is timestamp
        && data.trial_started_at <= request.time
        && data.trial_ends_at == data.trial_started_at + duration.value(3, 'd')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/onboarding/progress)
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)/onboarding/progress).data.onboarding_completed == true
          || get(/databases/$(database)/documents/users/$(request.auth.uid)/onboarding/progress).data.onboarding_exempt == true)
        && passesKycTrialGate(get(/databases/$(database)/documents/users/$(request.auth.uid)/onboarding/progress).data);
    }

    function isLegacyBillingMigration(userId, data) {
      return exists(/databases/$(database)/documents/users/$(userId)/billing/access)
        && data.trial_started_at == get(/databases/$(database)/documents/users/$(userId)/billing/access).data.trial_started_at
        && data.trial_ends_at == get(/databases/$(database)/documents/users/$(userId)/billing/access).data.trial_ends_at
        && (
          (data.status == 'active'
            && (get(/databases/$(database)/documents/users/$(userId)/billing/access).data.access_status in ['active', 'payment_verified']
              || get(/databases/$(database)/documents/users/$(userId)/billing/access).data.payment_status == 'verified'))
          || (data.status == 'pending_verification'
            && (get(/databases/$(database)/documents/users/$(userId)/billing/access).data.access_status == 'payment_submitted'
              || get(/databases/$(database)/documents/users/$(userId)/billing/access).data.payment_status in ['submitted', 'under_review']))
          || (data.status == 'payment_failed'
            && get(/databases/$(database)/documents/users/$(userId)/billing/access).data.payment_status == 'rejected')
          || (data.status == 'expired'
            && get(/databases/$(database)/documents/users/$(userId)/billing/access).data.access_status == 'trial_expired')
          || (data.status == 'trialing'
            && get(/databases/$(database)/documents/users/$(userId)/billing/access).data.access_status in ['trial_active', 'trial_expiring'])
        );
    }

    // Internal Operations Console (Phase 1 MVP). Operational metadata only —
    // never financial ledger data. See the open `internal_*` matches below.
    function isValidInternalUser(data) {
      return (!('account_status' in data) || data.account_status in [
          'registered', 'kyc_incomplete', 'kyc_submitted', 'kyc_approved',
          'kyc_rejected', 'payment_pending', 'payment_submitted',
          'payment_verified', 'active', 'suspended'
        ])
        && (!('kyc_status' in data) || data.kyc_status in [
          'not_started', 'in_progress', 'submitted', 'needs_revision',
          'approved', 'rejected'
        ])
        && (!('payment_status' in data) || data.payment_status in [
          'not_required', 'pending', 'submitted', 'under_review',
          'verified', 'rejected', 'expired'
        ])
        && (!('payment_amount' in data) || data.payment_amount == null
          || (data.payment_amount is number && data.payment_amount >= 0 && data.payment_amount <= 999999999999))
        && (!('access_status' in data) || data.access_status in [
          'trial_not_started', 'trial_active', 'trial_expiring', 'trial_expired',
          'payment_pending', 'payment_submitted', 'payment_verified', 'active', 'suspended'
        ])
        && (!('trial_days_remaining' in data) || data.trial_days_remaining == null
          || (data.trial_days_remaining is number && data.trial_days_remaining >= 0))
        && (!('last_active_at' in data) || data.last_active_at is timestamp)
        && (!('archived' in data) || data.archived is bool)
        && (!('archived_at' in data) || data.archived_at == null || data.archived_at is timestamp)
        && (!('workspace_role' in data) || data.workspace_role == null
          || (data.workspace_role is string && data.workspace_role.size() <= 40))
        && (!('organization' in data) || data.organization == null
          || (data.organization is string && data.organization.size() <= 160))
        && (!('payment_proof_file_name' in data) || data.payment_proof_file_name == null
          || (data.payment_proof_file_name is string && data.payment_proof_file_name.size() <= 240))
        && (!('last_internal_note' in data) || data.last_internal_note == null
          || (data.last_internal_note is string && data.last_internal_note.size() <= 500))
        && (!('email' in data) || data.email == null
          || (data.email is string && data.email.size() <= 160))
        && (!('business_name' in data) || data.business_name == null
          || (data.business_name is string && data.business_name.size() <= 160));
    }

    function isValidDocumentMetadata(data) {
      return data.keys().hasAll([
          'file_name',
          'file_mime_type',
          'file_size',
          'storage_path',
          'document_role',
          'source_context',
          'upload_status',
          'extraction_status',
          'review_status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'file_name',
          'file_mime_type',
          'file_size',
          'storage_path',
          'document_role',
          'source_context',
          'target_collection',
          'target_id',
          'upload_status',
          'extraction_status',
          'review_status',
          'file_hash',
          'created_at',
          'updated_at'
        ])
        && data.file_name is string
        && data.file_name.size() > 0
        && data.file_name.size() <= 240
        && data.file_mime_type in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf']
        && data.file_size is number
        && data.file_size > 0
        && data.file_size <= 5 * 1024 * 1024
        && data.storage_path is string
        && data.storage_path.size() <= 400
        && data.document_role in ['receipt', 'invoice', 'payment_proof', 'revenue_proof', 'unknown_finance_document']
        && data.source_context in ['transaction', 'revenue', 'bill', 'subscription', 'payment']
        && (!('target_collection' in data) || data.target_collection == null || data.target_collection in ['transactions', 'bills', 'subscriptions'])
        && (!('target_id' in data) || data.target_id is string)
        && (!('file_hash' in data) || (data.file_hash is string && data.file_hash.size() <= 64))
        && data.upload_status in ['pending', 'uploaded', 'failed', 'removed']
        && data.extraction_status in ['not_requested', 'pending', 'completed', 'failed']
        && data.review_status in ['not_required', 'needs_review', 'confirmed', 'rejected']
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }



    function isValidAttachedDocuments(data) {
      return !('attached_documents' in data)
        || (data.attached_documents is list && data.attached_documents.size() <= 20);
    }

    function isValidAIChat(data) {
      return data.keys().hasAll([
          'title',
          'summary',
          'last_message_preview',
          'intent',
          'source',
          'created_at',
          'updated_at',
          'last_activity_at',
          'expires_at',
          'message_count',
          'status'
        ])
        && data.keys().hasOnly([
          'title',
          'summary',
          'last_message_preview',
          'intent',
          'source',
          'created_at',
          'updated_at',
          'last_activity_at',
          'expires_at',
          'message_count',
          'status',
          'deleted_at'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.summary is string
        && data.summary.size() <= 500
        && data.last_message_preview is string
        && data.last_message_preview.size() <= 500
        && data.intent is string
        && data.intent.size() > 0
        && data.intent.size() <= 80
        && data.source == 'ai_command_center'
        && data.created_at is timestamp
        && data.updated_at is timestamp
        && data.last_activity_at is timestamp
        && data.expires_at is timestamp
        && data.message_count is number
        && data.message_count >= 0
        && data.message_count <= 500
        && data.status in ['active', 'deleted']
        && (!('deleted_at' in data) || data.deleted_at is timestamp);
    }

    function isValidAIChatCreate(data) {
      return isValidAIChat(data)
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.last_activity_at == request.time
        && data.status == 'active'
        && !('deleted_at' in data);
    }

    function isValidAIChatUpdate(data, existingData) {
      return isValidAIChat(data)
        && data.created_at == existingData.created_at
        && data.updated_at == request.time
        && data.last_activity_at is timestamp;
    }

    function isValidAIChatMessage(data) {
      return data.keys().hasAll([
          'role',
          'content',
          'created_at',
          'expires_at'
        ])
        && data.keys().hasOnly([
          'role',
          'content',
          'structured_answer',
          'attachments',
          'created_at',
          'expires_at'
        ])
        && data.role in ['user', 'assistant', 'system']
        && data.content is string
        && data.content.size() <= 10000
        && (!('structured_answer' in data) || data.structured_answer == null || data.structured_answer is map)
        && (!('attachments' in data) || data.attachments is list)
        && data.created_at == request.time
        && data.expires_at is timestamp;
    }

    function isValidTrialAIUsage(data) {
      return data.keys().hasAll([
          'metric',
          'scope',
          'count',
          'limit'
        ])
        && data.keys().hasOnly([
          'metric',
          'scope',
          'count',
          'limit'
        ])
        && data.metric == 'ai_chat_requests'
        && data.scope == 'trial'
        && data.limit == 1
        && data.count is number
        && data.count >= 1
        && data.count <= 1;
    }

    function isValidTrialAIUsageCreate(limitId, data) {
      return limitId == 'ai_chat_trial'
        && isValidTrialAIUsage(data)
        && data.count == 1;
    }

    function isValidTrialAIUsageUpdate(limitId, data, existingData) {
      return limitId == 'ai_chat_trial'
        && isValidTrialAIUsage(data)
        && data.metric == existingData.metric
        && data.scope == existingData.scope
        && data.limit == existingData.limit
        && data.count == existingData.count + 1;
    }

    // Per-plan Fluxy AI counter, reset each billing period. The limit is
    // re-derived from the user's ACTIVE subscription plan via get(), so a client
    // cannot inflate it. Mirrors PLAN_AI_PERIOD_LIMITS in netlify/functions/api.js
    // and ai_chat_limit in assets/js/billing-config.js. Enterprise (unlimited)
    // writes no counter, so it has no entry here.
    function planMonthlyAiLimit(planId) {
      return planId == 'starter' ? 10
        : (planId == 'core' || planId == 'basic') ? 30
        : planId == 'growth' ? 100
        : -1;
    }

    function activePlanAiLimit(userId) {
      let path = /databases/$(database)/documents/users/$(userId)/billing_subscription/current;
      // `{}` rather than `null` when the doc is absent. A map|null union makes the
      // rules type-checker reject the file outright in the console ("Invalid type.
      // Received one of [null]. Expected one of [map]"), which blocked a deploy.
      // map.get(key, default) keeps the behaviour identical and fail-closed:
      // no doc, no status, or no plan_id all fall through to -1, and every caller
      // requires `limit > 0`, so -1 denies the write.
      let sub = exists(path) ? get(path).data : {};
      return (sub.get('status', '') == 'active' || sub.get('status', '') == 'cancel_scheduled')
        ? planMonthlyAiLimit(sub.get('plan_id', ''))
        : -1;
    }

    function isValidPlanAIUsageShape(userId, data) {
      let limit = activePlanAiLimit(userId);
      return data.keys().hasAll(['metric', 'scope', 'period', 'count', 'limit'])
        && data.keys().hasOnly(['metric', 'scope', 'period', 'count', 'limit'])
        && data.metric == 'ai_chat_requests'
        && data.scope == 'plan'
        && data.period is string
        && limit > 0
        && data.limit == limit
        && data.count is number
        && data.count >= 1
        && data.count <= limit;
    }

    function isValidPlanAIUsageCreate(limitId, userId, data) {
      return limitId.matches('ai_chat_[0-9]{4}-[0-9]{2}')
        && isValidPlanAIUsageShape(userId, data)
        && data.count == 1;
    }

    function isValidPlanAIUsageUpdate(limitId, userId, data, existingData) {
      return limitId.matches('ai_chat_[0-9]{4}-[0-9]{2}')
        && isValidPlanAIUsageShape(userId, data)
        && data.metric == existingData.metric
        && data.scope == existingData.scope
        && data.period == existingData.period
        && data.limit == existingData.limit
        && data.count == existingData.count + 1;
    }

    // Billing-period Fluxy AI counter (single doc `ai_chat_plan`). `period_start`
    // must equal the subscription's current_period_start, so a client cannot
    // forge an early reset (billing_subscription is owner-protected and only
    // advanced by the verified billing flow). Mirrors the `ai_chat_plan` path in
    // consumeAIQuotaIfNeeded (netlify/functions/api.js).
    function subscriptionPeriodStart(userId) {
      let path = /databases/$(database)/documents/users/$(userId)/billing_subscription/current;
      return exists(path) ? get(path).data.current_period_start : null;
    }

    function isValidPlanPeriodAIUsageShape(userId, data) {
      let limit = activePlanAiLimit(userId);
      return data.keys().hasAll(['metric', 'scope', 'period_start', 'count', 'limit'])
        && data.keys().hasOnly(['metric', 'scope', 'period_start', 'count', 'limit'])
        && data.metric == 'ai_chat_requests'
        && data.scope == 'plan'
        && data.period_start is timestamp
        && data.period_start == subscriptionPeriodStart(userId)
        && limit > 0
        && data.limit == limit
        && data.count is number
        && data.count >= 1
        && data.count <= limit;
    }

    function isValidPlanPeriodAIUsageCreate(limitId, userId, data) {
      return limitId == 'ai_chat_plan'
        && isValidPlanPeriodAIUsageShape(userId, data)
        && data.count == 1;
    }

    function isValidPlanPeriodAIUsageUpdate(limitId, userId, data, existingData) {
      return limitId == 'ai_chat_plan'
        && isValidPlanPeriodAIUsageShape(userId, data)
        && data.metric == existingData.metric
        && data.scope == existingData.scope
        && data.limit == existingData.limit
        && (
          // Same period: monotonic +1 increment.
          (data.period_start == existingData.period_start && data.count == existingData.count + 1)
          // New billing period (period_start advanced): reset to 1.
          || (data.period_start != existingData.period_start && data.count == 1)
        );
    }

    function isValidSettingsTimestamp(data) {
      return data.updated_at == request.time;
    }

    function isValidCompanySettings(data) {
      return data.keys().hasAll([
          'business_name',
          'business_type',
          'country',
          'entity_label',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'business_name',
          'business_type',
          'country',
          'entity_label',
          'updated_at'
        ])
        && data.business_name is string
        && data.business_name.size() > 0
        && data.business_name.size() <= 120
        && data.business_type is string
        && data.business_type.size() <= 80
        && data.country is string
        && data.country.size() > 0
        && data.country.size() <= 80
        && data.entity_label is string
        && data.entity_label.size() > 0
        && data.entity_label.size() <= 80
        && isValidSettingsTimestamp(data);
    }

    function isValidFinanceSettings(data) {
      return data.keys().hasAll([
          'currency',
          'locale',
          'timezone',
          'date_format',
          'categories',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'currency',
          'locale',
          'timezone',
          'date_format',
          'categories',
          'updated_at'
        ])
        && isWorkspaceCurrency(data.currency)
        && data.locale in ['id-ID', 'en-PH', 'en-SG', 'ms-MY']
        && data.timezone in ['Asia/Jakarta', 'Asia/Makassar', 'Asia/Jayapura']
        && data.date_format in ['DD MMM YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD']
        && data.categories is list
        && data.categories.size() <= 8
        && isValidSettingsTimestamp(data);
    }

    function isValidImportRulesSettings(data) {
      return data.keys().hasAll([
          'csv_date_behavior',
          'unknown_document_route',
          'bill_scan_behavior',
          'receipt_scan_behavior',
          'payment_screenshot_behavior',
          'require_confirmation_before_save',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'csv_date_behavior',
          'unknown_document_route',
          'bill_scan_behavior',
          'receipt_scan_behavior',
          'payment_screenshot_behavior',
          'require_confirmation_before_save',
          'updated_at'
        ])
        && data.csv_date_behavior in ['use_row_date', 'use_upload_date']
        && data.unknown_document_route == 'ai_review'
        && data.bill_scan_behavior == 'create_bill_draft'
        && data.receipt_scan_behavior == 'create_ledger_draft'
        && data.payment_screenshot_behavior == 'create_review_item'
        && data.require_confirmation_before_save == true
        && isValidSettingsTimestamp(data);
    }

    function isValidAISettings(data) {
      return data.keys().hasAll([
          'answer_style',
          'default_analysis_period',
          'show_data_quality_warnings',
          'allow_ai_suggestions',
          'allow_ai_draft_actions',
          'require_confirmation_before_save',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'answer_style',
          'default_analysis_period',
          'show_data_quality_warnings',
          'allow_ai_suggestions',
          'allow_ai_draft_actions',
          'require_confirmation_before_save',
          'updated_at'
        ])
        && data.answer_style in ['concise', 'practical', 'detailed']
        && data.default_analysis_period in ['current_month', 'last_month', 'last_90_days']
        && data.show_data_quality_warnings is bool
        && data.allow_ai_suggestions is bool
        && data.allow_ai_draft_actions is bool
        && data.require_confirmation_before_save == true
        && isValidSettingsTimestamp(data);
    }

    function isValidReportsSettings(data) {
      return data.keys().hasOnly([
          'arr_source',
          'recurring_revenue_category_ids',
          'updated_at'
        ])
        && data.arr_source in ['none', 'tagged_income_categories']
        && data.recurring_revenue_category_ids is list
        && data.recurring_revenue_category_ids.size() <= 32
        && isValidSettingsTimestamp(data);
    }

    function isValidWhatsAppSettings(data) {
      return data.keys().hasAll([
          'status',
          'phone_number',
          'business_display_name',
          'last_sync_at',
          'last_verified_at',
          'provider',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'status',
          'phone_number',
          'business_display_name',
          'last_sync_at',
          'last_verified_at',
          'provider',
          'updated_at'
        ])
        && data.status in ['not_connected', 'pending', 'connected']
        && (data.phone_number == null || (data.phone_number is string && data.phone_number.size() <= 32))
        && (data.business_display_name == null || (data.business_display_name is string && data.business_display_name.size() <= 120))
        && (data.last_sync_at == null || data.last_sync_at is timestamp)
        && (data.last_verified_at == null || data.last_verified_at is timestamp)
        && data.provider == 'whatsapp_cloud_api'
        && isValidSettingsTimestamp(data);
    }

    function isValidSettingsDoc(settingsDoc, data) {
      return (settingsDoc == 'company' && isValidCompanySettings(data))
        || (settingsDoc == 'finance' && isValidFinanceSettings(data))
        || (settingsDoc == 'import_rules' && isValidImportRulesSettings(data))
        || (settingsDoc == 'ai' && isValidAISettings(data))
        || (settingsDoc == 'whatsapp' && isValidWhatsAppSettings(data))
        || (settingsDoc == 'reports' && isValidReportsSettings(data))
        || (settingsDoc == 'email_preferences' && isValidEmailPreferencesSettings(data));
    }

    // Weekly Financial Digest preferences (users/{uid}/settings/email_preferences).
    // Enums/bools/bounds only — no secrets. See docs/PROJECT_BACKGROUND.md §4e.
    function isValidEmailPreferencesSettings(data) {
      return data.keys().hasOnly([
          'weekly_digest_enabled', 'language', 'delivery_day', 'delivery_hour', 'timezone', 'metrics', 'updated_at'
        ])
        && data.keys().hasAll([
          'weekly_digest_enabled', 'delivery_day', 'delivery_hour', 'timezone', 'metrics', 'updated_at'
        ])
        // Email Language ('id' | 'en') — optional: absent means "follow the
        // dashboard/finance locale" (see functions/lib/locale.js fallbacks).
        && (!data.keys().hasAny(['language']) || data.language in ['id', 'en'])
        && data.weekly_digest_enabled is bool
        && data.delivery_day in ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday']
        && data.delivery_hour is int && data.delivery_hour >= 0 && data.delivery_hour <= 23
        && data.timezone is string && data.timezone.size() > 0 && data.timezone.size() <= 64
        && data.metrics is map
        && data.metrics.keys().hasOnly([
          'financial_health', 'cash_position', 'bills', 'budgets', 'revenue', 'expenses', 'subscriptions', 'vendors'
        ])
        && data.metrics.keys().hasAll([
          'financial_health', 'cash_position', 'bills', 'budgets', 'revenue', 'expenses', 'subscriptions', 'vendors'
        ])
        && data.metrics.financial_health is bool
        && data.metrics.cash_position is bool
        && data.metrics.bills is bool
        && data.metrics.budgets is bool
        && data.metrics.revenue is bool
        && data.metrics.expenses is bool
        && data.metrics.subscriptions is bool
        && data.metrics.vendors is bool
        && isValidSettingsTimestamp(data);
    }

    function isValidTourId(tourId) {
      return tourId == null
        || tourId in ['overview', 'ledger', 'bills', 'fluxy_ai', 'revenue_sync', 'subscriptions'];
    }

    function isValidPlatformLearningState(data) {
      return data.keys().hasOnly([
          'dismissed',
          'dismissed_at',
          'first_rendered_at',
          'last_seen_at',
          'started_tours',
          'completed_tours',
          'skipped_tours',
          'active_tour',
          'updated_at'
        ])
        && (!('dismissed' in data) || data.dismissed is bool)
        && (!('dismissed_at' in data) || data.dismissed_at == null || data.dismissed_at is timestamp)
        && (!('first_rendered_at' in data) || data.first_rendered_at is timestamp)
        && (!('last_seen_at' in data) || data.last_seen_at is timestamp)
        && (!('started_tours' in data) || (data.started_tours is list && data.started_tours.size() <= 12))
        && (!('completed_tours' in data) || (data.completed_tours is list && data.completed_tours.size() <= 12))
        && (!('skipped_tours' in data) || (data.skipped_tours is list && data.skipped_tours.size() <= 12))
        && (!('active_tour' in data) || isValidTourId(data.active_tour))
        && (!('updated_at' in data) || data.updated_at == request.time);
    }

    function isValidBankAccount(data) {
      return data.keys().hasAll([
          'account_name',
          'bank_name',
          'currency',
          'source_type',
          'status',
          'latest_balance',
          'latest_balance_at',
          'sync_status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'account_name',
          'bank_name',
          'bank_code',
          'currency',
          'last_four',
          'source_type',
          'provider',
          'provider_account_id',
          'status',
          'latest_balance',
          'latest_balance_at',
          'sync_status',
          'last_sync_at',
          'confidence',
          'notes',
          'created_at',
          'updated_at'
        ])
        && data.account_name is string
        && data.account_name.size() > 0
        && data.account_name.size() <= 120
        && data.bank_name is string
        && data.bank_name.size() > 0
        && data.bank_name.size() <= 80
        && (!('bank_code' in data) || data.bank_code == null || (data.bank_code is string && data.bank_code.size() <= 16))
        && isWorkspaceCurrency(data.currency)
        && (!('last_four' in data) || data.last_four == null || (data.last_four is string && data.last_four.size() <= 4))
        && data.source_type in ['manual', 'statement_upload', 'auto_sync']
        && (!('provider' in data) || data.provider == null || (data.provider is string && data.provider.size() <= 40))
        && (!('provider_account_id' in data) || data.provider_account_id == null || (data.provider_account_id is string && data.provider_account_id.size() <= 120))
        && data.status in ['active', 'archived']
        && data.latest_balance is number
        && data.latest_balance >= 0
        && data.latest_balance <= 999999999999
        && data.latest_balance_at is timestamp
        && data.sync_status in ['manual', 'pending', 'connected', 'failed']
        && (!('last_sync_at' in data) || data.last_sync_at == null || data.last_sync_at is timestamp)
        && (!('confidence' in data) || data.confidence == null || data.confidence in ['user_entered', 'extracted', 'synced'])
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidBankAccountCreate(data) {
      return isValidBankAccount(data)
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function isValidBankAccountUpdate(data, existingData) {
      return isValidBankAccount(data)
        && data.created_at == existingData.created_at
        && data.updated_at == request.time;
    }

    // Vendor master (workspace-scoped): named vendors with a default categorizing
    // account, currency, payment terms, and NPWP. No amounts/balances — those live
    // on bills. Soft-archive only (status), never deleted.
    function isValidVendor(data) {
      return data.keys().hasAll(['name', 'name_key', 'default_currency', 'status', 'created_at', 'updated_at'])
        && data.keys().hasOnly([
          'name', 'name_key', 'default_account_code', 'default_account_name',
          'default_currency', 'payment_terms', 'npwp', 'notes', 'status', 'created_at', 'updated_at'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.name_key is string && data.name_key.size() > 0 && data.name_key.size() <= 160
        && (!('default_account_code' in data) || data.default_account_code == null || (data.default_account_code is string && data.default_account_code.size() <= 12))
        && (!('default_account_name' in data) || data.default_account_name == null || (data.default_account_name is string && data.default_account_name.size() <= 80))
        && isFaceCurrency(data.default_currency)
        && (!('payment_terms' in data) || data.payment_terms == null || data.payment_terms in ['due_on_receipt', 'due_in_7_days', 'due_in_14_days', 'due_in_30_days'])
        && (!('npwp' in data) || data.npwp == null || (data.npwp is string && data.npwp.size() <= 32))
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && data.status in ['active', 'archived'];
    }
    function isValidVendorCreate(data) {
      return isValidVendor(data) && data.created_at == request.time && data.updated_at == request.time;
    }
    function isValidVendorUpdate(data, existingData) {
      return isValidVendor(data) && data.created_at == existingData.created_at && data.updated_at == request.time
        && data.name_key == existingData.name_key;
    }

    function isValidBankBalanceSnapshot(data) {
      return data.keys().hasAll([
          'bank_account_id',
          'balance',
          'currency',
          'source_type',
          'snapshot_at',
          'created_at'
        ])
        && data.keys().hasOnly([
          'bank_account_id',
          'balance',
          'currency',
          'source_type',
          'snapshot_at',
          'confidence',
          'notes',
          'created_at'
        ])
        && data.bank_account_id is string
        && data.bank_account_id.size() > 0
        && data.bank_account_id.size() <= 120
        && data.balance is number
        && data.balance >= 0
        && data.balance <= 999999999999
        && isWorkspaceCurrency(data.currency)
        && data.source_type in ['manual', 'statement_upload', 'auto_sync']
        && data.snapshot_at is timestamp
        && (!('confidence' in data) || data.confidence == null || data.confidence in ['user_entered', 'extracted', 'synced'])
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && data.created_at == request.time;
    }

    function isValidBudget(data) {
      return data.keys().hasAll([
          'name',
          'period_type',
          'period_start',
          'period_end',
          'currency',
          'total_budget',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'name',
          'budget_type',
          'parent_budget_id',
          'period_type',
          'period_label',
          'period_start',
          'period_end',
          'currency',
          'total_budget',
          'category_budgets',
          'notes',
          'status',
          'created_from_budget_id',
          'created_at',
          'updated_at'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && (!('budget_type' in data) || data.budget_type in ['annual', 'period'])
        && (!('parent_budget_id' in data) || data.parent_budget_id == null || (data.parent_budget_id is string && data.parent_budget_id.size() <= 120))
        && data.period_type in ['monthly', 'quarterly', 'yearly', 'custom']
        && (!('period_label' in data) || data.period_label == null || (data.period_label is string && data.period_label.size() <= 120))
        && data.period_start is timestamp
        && data.period_end is timestamp
        && isWorkspaceCurrency(data.currency)
        && data.total_budget is number
        && data.total_budget >= 0
        && data.total_budget <= 999999999999
        && (!('category_budgets' in data) || data.category_budgets is map)
        && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 500))
        && (!('created_from_budget_id' in data) || data.created_from_budget_id == null || (data.created_from_budget_id is string && data.created_from_budget_id.size() <= 120))
        && data.status in ['active', 'archived'];
    }

    function isValidBudgetAllocation(data) {
      return data.keys().hasAll([
          'parent_budget_id',
          'name',
          'allocated_amount',
          'scope_type',
          'scope_values',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'parent_budget_id',
          'name',
          'allocated_amount',
          'scope_type',
          'scope_values',
          'alert_threshold_percent',
          'hard_limit_enabled',
          'created_from_allocation_id',
          'status',
          'created_at',
          'updated_at'
        ])
        && data.parent_budget_id is string
        && data.parent_budget_id.size() > 0
        && data.parent_budget_id.size() <= 120
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.allocated_amount is number
        && data.allocated_amount >= 0
        && data.allocated_amount <= 999999999999
        && data.scope_type == 'category'
        && data.scope_values is list
        && data.scope_values.size() > 0
        && data.scope_values.size() <= 10
        && (!('alert_threshold_percent' in data) || data.alert_threshold_percent == null || (data.alert_threshold_percent is number && data.alert_threshold_percent >= 0 && data.alert_threshold_percent <= 100))
        && (!('hard_limit_enabled' in data) || data.hard_limit_enabled is bool)
        && (!('created_from_allocation_id' in data) || data.created_from_allocation_id == null || (data.created_from_allocation_id is string && data.created_from_allocation_id.size() <= 120))
        && data.status in ['active', 'archived'];
    }

    function isValidBudgetAllocationCreate(data) {
      return isValidBudgetAllocation(data)
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function isValidBudgetAllocationUpdate(data, existingData) {
      return isValidBudgetAllocation(data)
        && data.created_at == existingData.created_at
        && data.updated_at == request.time;
    }


    function isValidTransactionBudgetFields(data) {
      return (!('budget_id' in data) || data.budget_id == null || (data.budget_id is string && data.budget_id.size() <= 120))
        && (!('budget_allocation_id' in data) || data.budget_allocation_id == null || (data.budget_allocation_id is string && data.budget_allocation_id.size() <= 120))
        && (!('budget_match_method' in data) || data.budget_match_method == null || data.budget_match_method in ['auto', 'manual', 'rule', 'excluded', 'none'])
        && (!('budget_match_status' in data) || data.budget_match_status == null || data.budget_match_status in ['matched', 'needs_review', 'unmatched', 'excluded'])
        && (!('budget_match_confidence' in data) || data.budget_match_confidence == null || (data.budget_match_confidence is number && data.budget_match_confidence >= 0 && data.budget_match_confidence <= 1))
        && (!('budget_assignment_reason' in data) || data.budget_assignment_reason == null || (data.budget_assignment_reason is string && data.budget_assignment_reason.size() <= 500))
        && (!('budget_assignment_updated_at' in data) || data.budget_assignment_updated_at == null || data.budget_assignment_updated_at is timestamp)
        && (!('budget_assignment_updated_by' in data) || data.budget_assignment_updated_by == null || (data.budget_assignment_updated_by is string && data.budget_assignment_updated_by == request.auth.uid))
        && (!('budget_exclusion_reason' in data) || data.budget_exclusion_reason == null || (data.budget_exclusion_reason is string && data.budget_exclusion_reason.size() <= 500));
    }

    function preservesLegacyRecordDate(data, existingData) {
      return !('date' in data)
        || (('date' in existingData) && data.date == existingData.date);
    }

    function isValidBudgetCreate(data) {
      return isValidBudget(data)
        && data.created_at == request.time
        && data.updated_at == request.time;
    }

    function isValidBudgetUpdate(data, existingData) {
      return isValidBudget(data)
        && data.created_at == existingData.created_at
        && data.updated_at == request.time;
    }

    // ===== Invoices (Create Invoice MVP) =====
    // Customer invoices under users/{uid}/invoices. Amounts are raw integer
    // Rupiah — never formatted strings. A finalized (open) invoice is an
    // expected receivable only; it never creates a ledger transaction.
    // See docs/fluxyos_create_invoice_feature_plan.md.
    function isValidInvoiceAmounts(data) {
      return data.subtotal_amount is number
        && data.subtotal_amount >= 0
        && data.subtotal_amount <= 999999999999
        && data.tax_amount is number
        && data.tax_amount >= 0
        && data.tax_amount <= 999999999999
        && data.discount_amount is number
        && data.discount_amount >= 0
        && data.discount_amount <= 999999999999
        && data.total_amount is number
        && data.total_amount >= 0
        && data.total_amount <= 999999999999
        && data.amount_due is number
        && data.amount_due >= 0
        && data.amount_due <= 999999999999;
    }

    // Lean tax validator for INVOICES only. isValidInvoiceBase's allowlist permits
    // just the customer-withholding tax fields (customer_npwp + rate/type/code);
    // tax_amount + tax_rate_percent are already validated inline. Running the full
    // 16-field isValidTaxDocFields here (which also checks vendor/faktur/withholding
    // fields that an invoice can never carry) needlessly inflated the finalize
    // (draft->open) expression past the rules-evaluation budget on withholding
    // invoices — surfacing as permission-denied. Keep this to the 4 real fields.
    function isValidInvoiceTaxFields(data) {
      return (!('customer_npwp' in data) || data.customer_npwp == null || (data.customer_npwp is string && data.customer_npwp.size() <= 32))
        && (!('customer_withholding_rate' in data) || data.customer_withholding_rate == null || (data.customer_withholding_rate is number && data.customer_withholding_rate >= 0 && data.customer_withholding_rate <= 100))
        && (!('customer_withholding_type' in data) || data.customer_withholding_type == null || (data.customer_withholding_type is string && data.customer_withholding_type.size() <= 40))
        && (!('customer_withholding_code' in data) || data.customer_withholding_code == null || (data.customer_withholding_code is string && data.customer_withholding_code.size() <= 40));
    }

    function isValidInvoiceBase(data) {
      return data.keys().hasOnly([
          'invoice_number',
          'status',
          'currency',
          'customer_name',
          'customer_email',
          'customer_address',
          'customer_language',
          'issue_date',
          'due_date',
          'due_terms',
          'item_count',
          'subtotal_amount',
          'tax_amount',
          'tax_rate_percent',
          'discount_amount',
          'total_amount',
          'amount_due',
          'memo',
          'footer',
          'payment_collection_method',
          'payment_link_enabled',
          'payment_page_url',
          'finalized_at',
          'sent_at',
          'paid_at',
          'linked_transaction_id',
          'voided_at',
          'void_reason',
          'created_at',
          'updated_at',
          'created_by',
          'updated_by',
          'journal_ref',
          'accounting_status',
          'customer_npwp',
          'customer_withholding_rate',
          'customer_withholding_type',
          'customer_withholding_code',
          'amount_paid_idr',
          'fx_rate',
          'fx_rate_date'
        ])
        && isValidAccountingLink(data)
        && isValidInvoiceTaxFields(data)
        && data.keys().hasAll([
          'invoice_number',
          'status',
          'currency',
          'customer_name',
          'customer_email',
          'issue_date',
          'due_terms',
          'item_count',
          'subtotal_amount',
          'tax_amount',
          'discount_amount',
          'total_amount',
          'amount_due',
          'payment_collection_method',
          'created_at',
          'updated_at',
          'created_by',
          'updated_by'
        ])
        && data.invoice_number is string
        && data.invoice_number.size() > 0
        && data.invoice_number.size() <= 40
        && data.status in ['draft', 'open', 'void', 'paid']
        && isFaceCurrency(data.currency)
        && (!('amount_paid_idr' in data) || data.amount_paid_idr == null || (data.amount_paid_idr is int && data.amount_paid_idr >= 0))
        && (!('fx_rate' in data) || data.fx_rate == null || data.fx_rate is number)
        && (!('fx_rate_date' in data) || data.fx_rate_date == null || (data.fx_rate_date is string && data.fx_rate_date.size() <= 20))
        && data.customer_name is string
        && data.customer_name.size() <= 160
        && (data.customer_email == null
          || (data.customer_email is string && data.customer_email.size() <= 160))
        && (!('customer_address' in data) || data.customer_address == null
          || (data.customer_address is string && data.customer_address.size() <= 500))
        && (!('customer_language' in data)
          || (data.customer_language is string && data.customer_language.size() <= 40))
        && data.issue_date is timestamp
        && (!('due_date' in data) || data.due_date == null || data.due_date is timestamp)
        && data.due_terms is string
        && data.due_terms.size() <= 40
        && data.item_count is number
        && data.item_count >= 0
        && data.item_count <= 200
        && isValidInvoiceAmounts(data)
        && (!('tax_rate_percent' in data)
          || data.tax_rate_percent == null
          || (data.tax_rate_percent is number && data.tax_rate_percent >= 0 && data.tax_rate_percent <= 100))
        && (!('memo' in data)
          || data.memo == null
          || (data.memo is string && data.memo.size() <= 500))
        && (!('footer' in data)
          || data.footer == null
          || (data.footer is string && data.footer.size() <= 500))
        && data.payment_collection_method in ['request_payment', 'manual_only']
        && (!('payment_link_enabled' in data) || data.payment_link_enabled is bool)
        && (!('payment_page_url' in data) || data.payment_page_url == null)
        && (!('finalized_at' in data) || data.finalized_at == null || data.finalized_at is timestamp)
        && (!('sent_at' in data) || data.sent_at == null || data.sent_at is timestamp)
        && (!('paid_at' in data) || data.paid_at == null || data.paid_at is timestamp)
        && (!('linked_transaction_id' in data)
          || data.linked_transaction_id == null
          || (data.linked_transaction_id is string && data.linked_transaction_id.size() <= 160))
        && (!('voided_at' in data) || data.voided_at == null || data.voided_at is timestamp)
        && (!('void_reason' in data)
          || data.void_reason == null
          || (data.void_reason is string && data.void_reason.size() > 0 && data.void_reason.size() <= 500));
    }

    function isValidInvoiceCreate(data) {
      return isValidInvoiceBase(data)
        && data.status == 'draft'
        && (!('finalized_at' in data) || data.finalized_at == null)
        && (!('sent_at' in data) || data.sent_at == null)
        && (!('paid_at' in data) || data.paid_at == null)
        && (!('linked_transaction_id' in data) || data.linked_transaction_id == null)
        && (!('voided_at' in data) || data.voided_at == null)
        && (!('void_reason' in data) || data.void_reason == null)
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.created_by == request.auth.uid
        && data.updated_by == request.auth.uid;
    }

    // Mark paid: open -> paid. Deliberately does NOT run isValidInvoiceBase:
    // the diff is restricted to these exact keys (each validated here), so the
    // rest of the already-validated doc cannot change — and skipping the heavy
    // base validator keeps this transition inside the rules evaluation budget
    // (a full-base + 5-branch evaluation on a 35+-key invoice was tipping over
    // it and surfacing as permission-denied on tax-carrying invoices).
    function isValidInvoicePaidTransition(data, existingData) {
      return existingData.status == 'open'
        && data.status == 'paid'
        && data.paid_at == request.time
        && data.linked_transaction_id is string
        && data.linked_transaction_id.size() > 0
        && data.updated_at == request.time
        && data.updated_by == request.auth.uid
        // Foreign-currency payments also stamp the FX provenance + the Rupiah
        // amount posted to the ledger (see markInvoicePaid).
        && (!('amount_paid_idr' in data) || data.amount_paid_idr == null || (data.amount_paid_idr is int && data.amount_paid_idr >= 0))
        && (!('fx_rate' in data) || data.fx_rate == null || data.fx_rate is number)
        && (!('fx_rate_date' in data) || data.fx_rate_date == null || (data.fx_rate_date is string && data.fx_rate_date.size() <= 20))
        && data.diff(existingData).affectedKeys().hasOnly(
             ['status', 'paid_at', 'linked_transaction_id', 'updated_at', 'updated_by', 'amount_paid_idr', 'fx_rate', 'fx_rate_date']);
    }

    // Cash application (Phase 2): record a payment against an IDR, non-withholding
    // invoice. Allows open->partial, partial->partial, and open/partial->paid. Like
    // isValidInvoicePaidTransition, it deliberately SKIPS isValidInvoiceBase and
    // restricts the diff to these exact payment keys, so the rest of the already
    // validated doc cannot change AND the evaluation stays inside the rules budget
    // (a full-base re-eval on a 35+-key invoice tips it over -> permission-denied).
    function isValidInvoicePartialTransition(data, existingData) {
      return existingData.status in ['open', 'partial']
        && data.status in ['partial', 'paid']
        && data.amount_paid is int && data.amount_paid >= 0
        && data.outstanding_amount is int && data.outstanding_amount >= 0
        && data.last_payment_transaction_id is string && data.last_payment_transaction_id.size() > 0
        && data.linked_transaction_id is string && data.linked_transaction_id.size() > 0
        && (data.status == 'paid'
              ? data.paid_at == request.time
              : (!('paid_at' in data) || data.paid_at == existingData.paid_at))
        && data.updated_at == request.time
        && data.updated_by == request.auth.uid
        && data.diff(existingData).affectedKeys().hasOnly(
             ['status', 'amount_paid', 'outstanding_amount', 'last_payment_transaction_id',
              'linked_transaction_id', 'paid_at', 'updated_at', 'updated_by']);
    }

    // Void rollback: a payment transaction was voided, which reversed its INV-PAY
    // journal and put the receivable back in the general ledger — so the invoice
    // has to give the settlement back or A/R disagrees with the invoice list.
    //
    // This needs its own transition because the two above cannot express it:
    // isValidInvoicePartialTransition requires existingData.status in
    // ['open','partial'] and so rejects paid->partial, and isValidInvoicePaidTransition
    // only goes open->paid. The only remaining branch is the full isValidInvoiceBase,
    // which is exactly the re-eval that tips a 35+-key invoice over the rules
    // budget and surfaces as permission-denied. Lean and self-contained, like its
    // two siblings, for that reason.
    //
    // Direction is enforced: paid/partial only ever move BACK to partial/open, and
    // paid_at must be cleared, so this cannot be used to settle anything.
    function isValidInvoiceVoidRollbackTransition(data, existingData) {
      return existingData.status in ['paid', 'partial']
        && data.status in ['partial', 'open']
        && data.amount_paid is int && data.amount_paid >= 0
        && data.outstanding_amount is int && data.outstanding_amount >= 0
        && (data.status == 'open' ? data.amount_paid == 0 : data.amount_paid > 0)
        && data.outstanding_amount > 0
        && data.paid_at == null
        && data.updated_at == request.time
        && data.updated_by == request.auth.uid
        && data.diff(existingData).affectedKeys().hasOnly(
             ['status', 'amount_paid', 'outstanding_amount', 'paid_at',
              'last_payment_transaction_id', 'linked_transaction_id',
              'updated_at', 'updated_by']);
    }

    function isValidInvoiceUpdate(data, existingData) {
      return isValidInvoicePartialTransition(data, existingData)
        || isValidInvoicePaidTransition(data, existingData)
        || isValidInvoiceVoidRollbackTransition(data, existingData)
        || (isValidInvoiceBase(data)
        && data.created_at == existingData.created_at
        && data.created_by == existingData.created_by
        && data.invoice_number == existingData.invoice_number
        && data.updated_at == request.time
        && data.updated_by == request.auth.uid
        && existingData.status in ['draft', 'open']
        && (
          // Draft edits stay draft.
          (existingData.status == 'draft'
            && data.status == 'draft'
            && (!('finalized_at' in data) || data.finalized_at == null)
            && (!('paid_at' in data) || data.paid_at == null)
            && (!('linked_transaction_id' in data) || data.linked_transaction_id == null)
            && (!('voided_at' in data) || data.voided_at == null))
          // Finalize: draft -> open. Requires customer, due date, items, total.
          || (existingData.status == 'draft'
            && data.status == 'open'
            && data.finalized_at == request.time
            && data.customer_name.size() > 0
            && data.total_amount > 0
            && data.item_count > 0
            && data.due_date is timestamp
            && (!('sent_at' in data) || data.sent_at == null || data.sent_at == request.time)
            && (!('paid_at' in data) || data.paid_at == null)
            && (!('linked_transaction_id' in data) || data.linked_transaction_id == null)
            && (!('voided_at' in data) || data.voided_at == null))
          // Finalize-only edits: an open invoice that has NOT been sent stays
          // editable in full. It remains open + unsent and keeps finalized_at;
          // the same required-field checks as finalize apply.
          || (existingData.status == 'open'
            && (!('sent_at' in existingData) || existingData.sent_at == null)
            && data.status == 'open'
            && data.finalized_at == existingData.finalized_at
            && (!('sent_at' in data) || data.sent_at == null)
            && (!('paid_at' in data) || data.paid_at == null)
            && (!('linked_transaction_id' in data) || data.linked_transaction_id == null)
            && (!('voided_at' in data) || data.voided_at == null)
            && data.customer_name.size() > 0
            && data.total_amount > 0
            && data.item_count > 0
            && data.due_date is timestamp)
          // Open invoices: metadata-only edits (memo/footer/record sent).
          || (existingData.status == 'open'
            && data.status == 'open'
            && data.diff(existingData).affectedKeys().hasOnly(['memo', 'footer', 'sent_at', 'updated_at', 'updated_by']))
          // Mark paid (open -> paid) is isValidInvoicePaidTransition above —
          // evaluated FIRST and without the base validator, on purpose.
          // Void instead of delete: draft/open -> void with a required reason.
          || (data.status == 'void'
            && data.voided_at == request.time
            && data.void_reason is string
            && data.void_reason.size() > 0
            && data.void_reason.size() <= 500)
        ));
    }

    function isValidInvoiceItem(data) {
      return data.keys().hasOnly([
          'description',
          'quantity',
          'unit_price',
          'amount',
          'position',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasAll([
          'description',
          'quantity',
          'unit_price',
          'amount',
          'created_at',
          'updated_at'
        ])
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 240
        && data.quantity is number
        && data.quantity > 0
        && data.quantity <= 999999
        && data.unit_price is number
        && data.unit_price >= 0
        && data.unit_price <= 999999999999
        && data.amount is number
        && data.amount >= 0
        && data.amount <= 999999999999
        && (!('position' in data) || (data.position is number && data.position >= 0 && data.position <= 200));
    }


    function isValidBankStatementImport(data) {
      return data.keys().hasAll([
          'file_name',
          'file_mime_type',
          'file_size',
          'document_type',
          'extraction_status',
          'review_status',
          'currency',
          'row_count',
          'balance_check_status',
          'running_balance_check_status',
          'duplicate_count',
          'needs_review_count',
          'created_at',
          'updated_at'
        ])
        && data.keys().hasOnly([
          'bank_account_id',
          'file_name',
          'file_mime_type',
          'file_size',
          'storage_path',
          'document_type',
          'extraction_status',
          'review_status',
          'bank_name',
          'account_holder',
          'account_number_masked',
          'currency',
          'statement_start_date',
          'statement_end_date',
          'opening_balance',
          'closing_balance',
          'total_debit',
          'total_credit',
          'row_count',
          'balance_check_status',
          'running_balance_check_status',
          'duplicate_count',
          'needs_review_count',
          'created_at',
          'updated_at',
          'confirmed_at',
          'imported_at',
          'reconciliation_status',
          'certified_at',
          'certified_by',
          'certified_closing_balance',
          'created_count',
          'matched_count'
        ])
        && data.file_name is string
        && data.file_name.size() > 0
        && data.file_name.size() <= 240
        && data.file_mime_type is string
        && data.file_mime_type.size() <= 160
        && data.file_size is number
        && data.file_size >= 0
        && data.file_size <= 10 * 1024 * 1024
        && (!('storage_path' in data) || data.storage_path == null || (data.storage_path is string && data.storage_path.size() <= 400))
        && data.document_type == 'bank_statement'
        && data.extraction_status in ['pending', 'processing', 'completed', 'failed']
        && data.review_status in ['draft', 'needs_review', 'ready_to_import', 'imported', 'rejected']
        && (!('bank_account_id' in data) || data.bank_account_id == null || (data.bank_account_id is string && data.bank_account_id.size() <= 120))
        && (!('bank_name' in data) || data.bank_name == null || (data.bank_name is string && data.bank_name.size() <= 80))
        && (!('account_holder' in data) || data.account_holder == null || (data.account_holder is string && data.account_holder.size() <= 160))
        && (!('account_number_masked' in data) || data.account_number_masked == null || (data.account_number_masked is string && data.account_number_masked.size() <= 32))
        && isWorkspaceCurrency(data.currency)
        && (!('statement_start_date' in data) || data.statement_start_date == null || data.statement_start_date is timestamp)
        && (!('statement_end_date' in data) || data.statement_end_date == null || data.statement_end_date is timestamp)
        && (!('opening_balance' in data) || data.opening_balance == null || data.opening_balance is number)
        && (!('closing_balance' in data) || data.closing_balance == null || data.closing_balance is number)
        && (!('total_debit' in data) || data.total_debit == null || data.total_debit is number)
        && (!('total_credit' in data) || data.total_credit == null || data.total_credit is number)
        && data.row_count is number
        && data.row_count >= 0
        && data.balance_check_status in ['passed', 'failed', 'unavailable']
        && data.running_balance_check_status in ['passed', 'failed', 'unavailable']
        && data.duplicate_count is number
        && data.duplicate_count >= 0
        && data.needs_review_count is number
        && data.needs_review_count >= 0
        && data.created_at is timestamp
        && data.updated_at is timestamp
        && (!('confirmed_at' in data) || data.confirmed_at == null || data.confirmed_at is timestamp)
        && (!('imported_at' in data) || data.imported_at == null || data.imported_at is timestamp)
        // Certification (reconciliation Phase A): certified_* only exists on a
        // certified import; kept lean for the rules eval budget.
        && (!('reconciliation_status' in data) || data.reconciliation_status == null || data.reconciliation_status in ['in_progress', 'certified'])
        && (!('certified_at' in data) || data.certified_at == null || data.certified_at is timestamp)
        && (!('certified_by' in data) || data.certified_by == null || (data.certified_by is string && data.certified_by.size() <= 120))
        && (!('certified_closing_balance' in data) || data.certified_closing_balance == null
            || (data.certified_closing_balance is number && data.certified_closing_balance >= 0))
        && (!('created_count' in data) || (data.created_count is number && data.created_count >= 0))
        && (!('matched_count' in data) || (data.matched_count is number && data.matched_count >= 0));
    }



    function isValidBankStatementRow(data) {
      return data.keys().hasOnly([
          'row_index',
          'transaction_date',
          'posting_date',
          'description_raw',
          'debit',
          'credit',
          'running_balance',
          'suggested_vendor_name',
          'suggested_category',
          'suggested_type',
          'match_status',
          'matched_transaction_id',
          'match_rule',
          'match_confidence',
          'confidence',
          'selected_for_import',
          'review_status',
          'created_transaction_id',
          'created_at'
        ])
        && data.row_index is number
        && data.row_index >= 0
        && (!('transaction_date' in data) || data.transaction_date == null || data.transaction_date is timestamp)
        && (!('posting_date' in data) || data.posting_date == null || data.posting_date is timestamp)
        && (!('description_raw' in data) || data.description_raw == null || (data.description_raw is string && data.description_raw.size() <= 500))
        && (!('debit' in data) || data.debit == null || data.debit is number)
        && (!('credit' in data) || data.credit == null || data.credit is number)
        && (!('running_balance' in data) || data.running_balance == null || data.running_balance is number)
        && (!('suggested_vendor_name' in data) || data.suggested_vendor_name == null || (data.suggested_vendor_name is string && data.suggested_vendor_name.size() <= 160))
        && (!('suggested_category' in data) || data.suggested_category == null || (data.suggested_category is string && data.suggested_category.size() <= 80))
        && (!('suggested_type' in data) || data.suggested_type == null || (data.suggested_type is string && data.suggested_type.size() <= 40))
        && (!('match_status' in data) || data.match_status in ['new', 'possible_duplicate', 'matched_existing', 'ignored', 'needs_review'])
        && (!('matched_transaction_id' in data) || data.matched_transaction_id == null || (data.matched_transaction_id is string && data.matched_transaction_id.size() <= 120))
        && (!('match_rule' in data) || data.match_rule == null || (data.match_rule is string && data.match_rule.size() <= 20))
        && (!('match_confidence' in data) || data.match_confidence == null || data.match_confidence in ['exact', 'strong', 'review'])
        && (!('confidence' in data) || data.confidence == null || data.confidence is number)
        && (!('selected_for_import' in data) || data.selected_for_import is bool)
        && (!('review_status' in data) || data.review_status in ['pending', 'confirmed', 'ignored', 'reconciled'])
        && (!('created_transaction_id' in data) || data.created_transaction_id == null || (data.created_transaction_id is string && data.created_transaction_id.size() <= 120))
        && data.created_at is timestamp;
    }

    match /users/{userId} {
      // NOTE: the user-scoped FINANCE rules (transactions, bills, invoices,
      // budgets, bank_*, documents, vendors, accounting_mappings, audit_logs,
      // report_exports, subscriptions, duplicate_reviews) were REMOVED
      // 2026-08-16, together with the validator functions only they called.
      //
      // Those collections moved to workspaces/{workspaceId}/ in the Stage 2
      // migration. _scope() has routed every client read there since — which the
      // qa-run scope guard enforces — and Netlify functions use the Admin SDK,
      // which bypasses rules entirely. The blocks were dead weight.
      //
      // They had to go because this ruleset hit a HARD RELEASE CEILING near
      // 223 KB: below the documented 256 KiB, and enforced at RELEASE rather
      // than compile, so adding any new collection failed with an opaque 400
      // while `--dry-run` still reported success. That is what blocked
      // goods_receipts and stock_movements.
      //
      // The users/{uid} DATA is untouched — it is the rollback net; only client
      // rule access is gone, and git holds these rules if ever needed. Identity
      // and billing below stay user-scoped by design (PROJECT_BACKGROUND §4.3).
      allow read: if isOwner(userId);
      allow create, update, delete: if false;

      // 3-day trial / billing access state (owner-scoped). Client writes are UX
      // only; production enforcement still needs backend/Cloud Functions.
      match /billing/{billingDoc} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      // Manual payment proof submissions (owner-scoped). Proof file lives in the
      // documents collection / Storage; this doc holds metadata + status only.
      match /payment_verifications/{paymentId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /billing_payment_requests/{paymentRequestId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidBillingPaymentRequest(request.resource.data)
          && hasValidPaymentRequestPrevSnapshot(userId, request.resource.data)
          && hasValidPaymentRequestVoucher(userId, paymentRequestId, request.resource.data);
        // Owner may confirm a QRIS payment (awaiting_payment -> pending_verification)
        // or cancel an in-flight payment (-> canceled).
        allow update: if isOwner(userId)
          && (
            isValidPaymentRequestVerificationSubmit(resource.data, request.resource.data)
            || isValidPaymentRequestCancel(resource.data, request.resource.data)
          );
        allow delete: if false;
      }

      match /billing_subscription/{subscriptionId} {
        allow read: if isOwner(userId) && subscriptionId == 'current';
        allow create: if isOwner(userId)
          && subscriptionId == 'current'
          && isValidBillingSubscription(request.resource.data)
          && (isTrialSubscriptionCreate(request.resource.data)
            || isCheckoutSubscriptionWrite(userId, request.resource.data)
            || isCheckoutAwaitingPaymentWrite(userId, request.resource.data)
            || isLegacyBillingMigration(userId, request.resource.data));
        allow update: if isOwner(userId)
          && subscriptionId == 'current'
          && isValidBillingSubscription(request.resource.data)
          && (
            isCheckoutSubscriptionWrite(userId, request.resource.data)
            || isCheckoutAwaitingPaymentWrite(userId, request.resource.data)
            || isCancelPaymentRevert(userId, resource.data, request.resource.data)
            || isCancelRestoreActive(userId, resource.data, request.resource.data)
            || isCancelRenewalWrite(resource.data, request.resource.data)
            || isReactivateRenewalWrite(resource.data, request.resource.data)
            || isInternalReviewReconcile(userId, resource.data, request.resource.data)
            || isActiveBillingPeriodBackfill(userId, resource.data, request.resource.data)
            || isLegacyBillingMigration(userId, request.resource.data)
            || (resource.data.status == 'trialing'
              && request.resource.data.status == 'expired'
              && resource.data.trial_ends_at is timestamp
              && resource.data.trial_ends_at < request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']))
          );
        allow delete: if false;
      }

      // Provider/backend-owned invoice history surfaced read-only on the
      // Billing & plan settings page (users/{uid}/billing_invoices). Invoices
      // are issued by a trusted backend after a successful payment, never by the
      // client, so every client write is blocked.
      match /billing_invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }








      match /ai_chats/{chatId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidAIChatCreate(request.resource.data);
        allow update: if isOwner(userId)
          && isValidAIChatUpdate(request.resource.data, resource.data);
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidAIChatMessage(request.resource.data);
          allow update, delete: if false;
        }
      }

      match /usage_limits/{limitId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && (isValidTrialAIUsageCreate(limitId, request.resource.data)
            || isValidPlanAIUsageCreate(limitId, userId, request.resource.data)
            || isValidPlanPeriodAIUsageCreate(limitId, userId, request.resource.data));
        allow update: if isOwner(userId)
          && (isValidTrialAIUsageUpdate(limitId, request.resource.data, resource.data)
            || isValidPlanAIUsageUpdate(limitId, userId, request.resource.data, resource.data)
            || isValidPlanPeriodAIUsageUpdate(limitId, userId, request.resource.data, resource.data));
        allow delete: if false;
      }

      match /settings/{settingsDoc} {
        allow read: if isOwner(userId)
          && settingsDoc in ['company', 'finance', 'import_rules', 'ai', 'whatsapp', 'reports', 'email_preferences'];
        allow create, update: if isOwner(userId)
          && isValidSettingsDoc(settingsDoc, request.resource.data);
        allow delete: if false;
      }

      match /onboarding/{onboardingDoc} {
        allow read: if isOwner(userId)
          && onboardingDoc in ['progress', 'profile', 'documents'];
        allow create, update: if isOwner(userId)
          && onboardingDoc in ['progress', 'profile', 'documents'];
        allow delete: if false;
      }








      match /platform_learning/{learningDoc} {
        allow read: if isOwner(userId) && learningDoc == 'state';
        allow create, update: if isOwner(userId)
          && learningDoc == 'state'
          && isValidPlatformLearningState(request.resource.data);
        allow delete: if false;
      }


      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ===== Internal Operations Console (Phase 1 MVP) =====
    // MVP_INTERNAL_ONLY_TEMPORARY — these top-level collections are intentionally
    // open because the internal console authenticates with a client-side
    // credential gate, not a Firebase identity. This exposes internal operational
    // metadata (no financial ledger data) and MUST be replaced with Firebase
    // custom claims or a backend-verified admin session before production.
    // See docs/internal_operations_console_plan.md §16 and §20.
    match /internal_users/{internalUserId} {
      allow read: if true;
      allow create, update: if isValidInternalUser(request.resource.data);
      allow delete: if false;
    }

    // Public Contact Sales leads. Written ONLY by the Admin SDK (the
    // submit-contact-sales Netlify function), which bypasses rules — so all
    // client writes are denied, keeping the public collection spam-proof. Read
    // is open for the credential-gated Internal Operations Console (Sales Leads
    // tab), same MVP_INTERNAL_ONLY posture as internal_users.
    match /sales_leads/{leadId} {
      allow read: if true;
      // Lead content is written ONLY by the Admin SDK (function) — create/delete
      // stay denied so the public collection can't be spammed or wiped. The
      // credential-gated console may flip ONLY the workflow status on an
      // existing lead; all core fields are immutable.
      allow create, delete: if false;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'status_updated_at'])
        && request.resource.data.status in ['new', 'contacted', 'closed', 'spam'];
    }

    match /outreach_leads/{leadId} {
      allow read: if true;
      allow create, update: if isValidOutreachLead(request.resource.data);
      allow delete: if true;
    }

    // Weekly digest broadcast jobs (internal-console "Send digest now"). The
    // console writes a pending job; the Netlify worker (Admin SDK + OpenAI)
    // executes it. MVP_INTERNAL_ONLY_TEMPORARY — open + field-validated, like
    // internal_users. The worker can only send the legit weekly digest (deduped
    // per ISO week), so the abuse ceiling is "trigger this week's digest early".
    match /internal_digest_jobs/{jobId} {
      allow read: if true;
      // `uid` targets ONE account instead of the whole roster. Optional — a job
      // without it stays the original broadcast. Bounded like every other id here;
      // the worker still applies the payment-verified gate, so naming a uid is a
      // narrowing, never a way past the rule.
      allow create, update: if request.resource.data.keys().hasOnly([
            'mode', 'status', 'requested_by', 'requested_at', 'started_at', 'finished_at', 'result', 'error', 'uid'
          ])
        && (!('uid' in request.resource.data) || request.resource.data.uid == null
          || (request.resource.data.uid is string && request.resource.data.uid.size() <= 128))
        && request.resource.data.mode in ['dryRun', 'send']
        && request.resource.data.status in ['pending', 'processing', 'done', 'failed']
        && request.resource.data.requested_by is string
        && request.resource.data.requested_by.size() <= 80
        && (request.resource.data.error == null
          || (request.resource.data.error is string && request.resource.data.error.size() <= 500));
      allow delete: if false;
    }

    match /internal_audit_logs/{auditLogId} {
      allow read: if true;
      allow create: if request.resource.data.source == 'internal_dashboard'
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.target_user_id is string
        && request.resource.data.target_user_id.size() <= 160
        && request.resource.data.created_at == request.time
        && (!('reason' in request.resource.data) || request.resource.data.reason == null
          || (request.resource.data.reason is string && request.resource.data.reason.size() <= 500));
      allow update, delete: if false;
    }

    // ===== Voucher codes (checkout discounts, internal-console managed) =====
    // MVP_INTERNAL_ONLY_TEMPORARY — like internal_users above, admin writes are
    // field-validated but NOT identity-gated, because the internal console has
    // no Firebase identity. Known gaps until custom-claims admin auth exists:
    //   - anyone who knows the paths can create/disable/delete vouchers or read
    //     redemptions (no financial gain: checkout math is still enforced by
    //     hasValidPaymentRequestVoucher against the voucher doc itself, and
    //     delete is no worse than the already-open disable — both only stop a
    //     code working at checkout; past voucher_redemptions are immutable);
    //   - any signed-in user can burn redemption slots via the bare +1 counter
    //     update (DoS on limited vouchers, never a bigger discount).

    // Doc ID == the normalized uppercase code, so codes are unique by
    // construction and checkout can validate with a single get() while `list`
    // stays denied (no enumeration via queries).
    function isValidVoucherCodeCreate(code, data) {
      return code.matches('^[A-Z0-9_-]{4,32}$')
        && data.keys().hasAll([
          'code', 'discount_type', 'discount_value', 'status',
          'max_redemptions', 'redemption_count', 'valid_from', 'valid_until',
          'allowed_plan_ids', 'allowed_billing_frequencies',
          'created_by', 'created_at', 'updated_at',
          'disabled_at', 'disabled_by', 'notes'
        ])
        && data.keys().hasOnly([
          'code', 'discount_type', 'discount_value', 'status',
          'max_redemptions', 'redemption_count', 'valid_from', 'valid_until',
          'allowed_plan_ids', 'allowed_billing_frequencies',
          'created_by', 'created_at', 'updated_at',
          'disabled_at', 'disabled_by', 'notes'
        ])
        && data.code == code
        && data.discount_type == 'percentage'
        && data.discount_value is int
        && data.discount_value >= 1
        && data.discount_value <= 100
        && data.status == 'active'
        && (data.max_redemptions == null
          || (data.max_redemptions is int && data.max_redemptions >= 1 && data.max_redemptions <= 100000))
        && data.redemption_count == 0
        && (data.valid_from == null || data.valid_from is timestamp)
        && (data.valid_until == null || data.valid_until is timestamp)
        && (data.valid_from == null || data.valid_until == null || data.valid_until > data.valid_from)
        && (data.allowed_plan_ids == null
          || (data.allowed_plan_ids is list
            && data.allowed_plan_ids.size() >= 1
            && data.allowed_plan_ids.hasOnly(['starter', 'core', 'growth', 'enterprise'])))
        && (data.allowed_billing_frequencies == null
          || (data.allowed_billing_frequencies is list
            && data.allowed_billing_frequencies.size() >= 1
            && data.allowed_billing_frequencies.hasOnly(['monthly', 'annually'])))
        && data.created_by is string
        && data.created_by.size() > 0
        && data.created_by.size() <= 80
        && data.created_at == request.time
        && data.updated_at == request.time
        && data.disabled_at == null
        && data.disabled_by == null
        && (data.notes == null || (data.notes is string && data.notes.size() <= 500));
    }

    // Checkout-side counter bump: only the counter (+updated_at) may change,
    // exactly +1, never past the cap, only while active. The bump itself is
    // tied to a real redemption by hasValidPaymentRequestVoucher in the same
    // commit (see the counter-burn caveat in the banner above).
    function isVoucherRedemptionIncrement(prev, next) {
      return request.auth != null
        && next.diff(prev).affectedKeys().hasOnly(['redemption_count', 'updated_at'])
        && next.redemption_count == prev.redemption_count + 1
        && (prev.max_redemptions == null || next.redemption_count <= prev.max_redemptions)
        && prev.status == 'active'
        && next.updated_at == request.time;
    }

    // Internal-console lifecycle edits. Code, discount percent, and the
    // redemption counter are immutable here; disabling must stamp who/when.
    function isValidVoucherAdminUpdate(prev, next) {
      return next.diff(prev).affectedKeys().hasOnly([
          'status', 'max_redemptions', 'valid_until', 'notes',
          'disabled_at', 'disabled_by', 'updated_at'
        ])
        && next.status in ['active', 'disabled', 'expired']
        && (
          next.status == prev.status
          || (next.status == 'disabled'
            && next.disabled_at == request.time
            && next.disabled_by is string
            && next.disabled_by.size() > 0
            && next.disabled_by.size() <= 80)
          || (next.status == 'active' && prev.status == 'disabled')
        )
        && (next.max_redemptions == null
          || (next.max_redemptions is int
            && next.max_redemptions >= 1
            && next.max_redemptions <= 100000
            && next.max_redemptions >= next.redemption_count))
        && (next.valid_until == null || next.valid_until is timestamp)
        && (next.notes == null || (next.notes is string && next.notes.size() <= 500))
        && next.updated_at == request.time;
    }

    match /voucher_codes/{voucherCode} {
      allow get: if true;
      allow list: if false;
      allow create: if isValidVoucherCodeCreate(voucherCode, request.resource.data);
      allow update: if isVoucherRedemptionIncrement(resource.data, request.resource.data)
        || isValidVoucherAdminUpdate(resource.data, request.resource.data);
      // Internal-console hard delete (MVP-open, same posture as create/disable
      // above). The console also arrayRemoves the code from voucher_code_index
      // in the same batch via the existing update rule.
      allow delete: if true;
    }

    // Registry of existing codes so the internal console can list vouchers
    // without a (denied) collection query. Maintained via arrayUnion in the
    // same batch as each voucher create.
    match /voucher_code_index/{indexId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if indexId == 'registry'
        && request.resource.data.keys().hasOnly(['codes', 'updated_at'])
        && request.resource.data.codes is list
        && request.resource.data.codes.size() <= 500
        && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }

    // One redemption per payment request (doc ID == the payment request ID).
    // Created only inside the checkout commit; its amounts must mirror the
    // payment request written in the SAME commit, so it doubles as the
    // tamper-proof redemption audit record.
    function isValidVoucherRedemptionCreate(redemptionId, data) {
      // `let` keeps the expression budget low (see hasAppliedPaymentRequestVoucher).
      // Unauthenticated requests error on request.auth.uid in the path → deny.
      let requestAfter = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/billing_payment_requests/$(redemptionId)).data;
      return request.auth != null
        && data.keys().hasAll([
          'voucher_id', 'code', 'user_id', 'checkout_session_id',
          'plan_id', 'billing_frequency',
          'original_amount', 'discount_amount', 'final_amount', 'currency',
          'status', 'created_at', 'redeemed_at'
        ])
        && data.keys().hasOnly([
          'voucher_id', 'code', 'user_id', 'checkout_session_id',
          'plan_id', 'billing_frequency',
          'original_amount', 'discount_amount', 'final_amount', 'currency',
          'status', 'created_at', 'redeemed_at'
        ])
        && data.voucher_id is string
        && data.voucher_id.matches('^[A-Z0-9_-]{4,32}$')
        && data.code == data.voucher_id
        && data.user_id == request.auth.uid
        && data.checkout_session_id == redemptionId
        && data.plan_id in ['starter', 'core', 'growth', 'enterprise']
        && data.billing_frequency in ['monthly', 'annually']
        && data.original_amount is number
        && data.original_amount > 0
        && data.discount_amount is number
        && data.discount_amount >= 0
        && data.final_amount is number
        && data.final_amount >= 0
        && data.currency == 'IDR'
        && data.status == 'reserved'
        && data.created_at == request.time
        && data.redeemed_at == null
        && requestAfter.voucher_id == data.voucher_id
        && requestAfter.plan_id == data.plan_id
        && requestAfter.billing_frequency == data.billing_frequency
        && requestAfter.subtotal_amount == data.original_amount
        && requestAfter.voucher_discount_amount == data.discount_amount
        && requestAfter.total_amount == data.final_amount;
    }

    // Internal-console resolution after manual payment review. No Firebase
    // identity exists on the console (see banner), so this is open like
    // internal_users; the transition matrix is the only protection.
    function isValidVoucherRedemptionStatusUpdate(prev, next) {
      return prev.status == 'reserved'
        && next.status in ['redeemed', 'cancelled']
        && next.diff(prev).affectedKeys().hasOnly(['status', 'redeemed_at'])
        && (next.status != 'redeemed' || next.redeemed_at == request.time)
        && (next.status != 'cancelled' || next.redeemed_at == null);
    }

    match /voucher_redemptions/{redemptionId} {
      allow read: if true;
      allow create: if isValidVoucherRedemptionCreate(redemptionId, request.resource.data);
      allow update: if isValidVoucherRedemptionStatusUpdate(resource.data, request.resource.data);
      allow delete: if false;
    }

    // ========================================================================
    // WORKSPACES — Team Management & RBAC (see docs/SECURITY_SYSTEM.md §3–6)
    //
    // Seeding rule: for existing single-user accounts workspaceId == owner uid.
    // STAGE 1 (this block) governs the workspace profile, membership, invites,
    // and workspace-scoped audit logs — the team-management feature. The finance
    // collections (transactions/bills/budgets/…) still live under users/{uid}
    // and migrate to workspaces/{workspaceId}/<collection> in STAGE 2; their
    // role-gated rules are added there alongside the data migration.
    // ========================================================================

    function memberPath(workspaceId, uid) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/members/$(uid);
    }
    function callerMember(workspaceId) {
      return get(memberPath(workspaceId, request.auth.uid)).data;
    }
    function isMember(workspaceId) {
      return isSignedIn()
        && exists(memberPath(workspaceId, request.auth.uid))
        && callerMember(workspaceId).status == 'active';
    }
    function hasRole(workspaceId, roles) {
      return isMember(workspaceId) && (callerMember(workspaceId).role in roles);
    }
    // The same four role lists were spelled out 117 times between them, which is
    // ~5KB of a file with 8KB of headroom left. They delegate to hasRole rather
    // than reimplementing it, so the boundary is still defined in exactly one
    // place. One extra call frame per check — irrelevant against the
    // 1000-expression budget, which is spent by the big hasOnly validators, not
    // by role lookups.
    function wsRead(workspaceId) {
      return hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'viewer']);
    }
    function wsWrite(workspaceId) {
      return hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant']);
    }
    // Read lists that additionally admit a till operator: the menu, the outlets,
    // the tables and the orders. NEVER widen this to a finance collection.
    function wsReadPos(workspaceId) {
      return hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'viewer', 'cashier']);
    }
    function wsAdmin(workspaceId) {
      return hasRole(workspaceId, ['owner', 'admin']);
    }
    // Till operator. NOT a finance role — never add it to a `viewer` read list,
    // that would hand floor staff the ledger. Create-without-read on transactions
    // + stock_adjustments is the design. docs/POS_IMPLEMENTATION_PLAN.md §9.2.
    function wsCashier(workspaceId) {
      return isMember(workspaceId) && callerMember(workspaceId).role == 'cashier';
    }

    // ---- POS order validators ----
    // Split per transition, not one big validator: the invoice open→paid rule
    // tripped the evaluation budget in production 2026-07-14. lines[]/payments[]
    // contents are validated in db-service.js (rules can't iterate cheaply).
    // A till sale, validated on its own terms. wsValidTxCreate is a 70-key
    // validator with a dozen sub-validators (tax, budget, recon, cash, capture);
    // adding the cashier clause on top of it tripped the 1000-expression
    // EVALUATION budget in the emulator — the same failure the invoice open→paid
    // transition hit in production on 2026-07-14. Finance callers keep the full
    // validator; a cashier evaluates only this.
    function wsValidPosTxCreate(data) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'timestamp', 'created_at',
          'source', 'accounting_status', 'dimension_id',
          'pos_order_id', 'pos_discount_amount', 'pos_discount_reason', 'pos_settlement', 'pos_refund_reason',
          'pos_cash_amount', 'pos_clearing_amount'
        ])
        && data.source == 'pos'
        && data.accounting_status == 'pending'
        && data.type in ['income', 'refund']
        && data.amount is number && data.amount > 0
        && data.pos_order_id is string && data.pos_order_id.size() > 0
        && data.pos_settlement in ['cash', 'clearing']
        && data.created_at == request.time;
    }
    // ---- POS shift (the cash drawer) ----
    // Split create/close for the same reason the order validators are split: one
    // validator that evaluates both branches on every write is how the 1000-
    // expression budget gets spent.
    function wsPosShiftKeys(data) {
      return data.keys().hasOnly([
          'dimension_id', 'status', 'opened_at', 'opened_by', 'opening_float',
          'movements', 'closed_at', 'closed_by', 'counted_cash', 'expected_cash',
          'variance', 'cash_sales', 'non_cash_sales', 'order_count', 'note',
          'journal_ref', 'accounting_status', 'reference', 'version', 'created_at', 'updated_at'
        ]);
    }
    function wsValidPosShiftCreate(data) {
      return wsPosShiftKeys(data)
        && data.dimension_id is string
        && data.status == 'open'
        && data.opening_float is number
        && data.opening_float >= 0
        && data.movements is list
        && data.version == 1
        && data.counted_cash == null
        && data.created_at == request.time;
    }
    // An open shift takes paid-in / paid-out, then closes ONCE.
    // `counted_cash` is what the person physically counted; it may never be
    // rewritten, because a second count with the first one visible is not a
    // blind count and the variance stops meaning anything.
    function wsValidPosShiftUpdate(data, prev) {
      return wsPosShiftKeys(data)
        && data.version == prev.version + 1
        && data.dimension_id == prev.dimension_id
        && data.opening_float == prev.opening_float
        && data.created_at == prev.created_at
        && data.status in ['open', 'closed']
        && data.movements is list
        && (prev.counted_cash == null || data.counted_cash == prev.counted_cash)
        && (data.status != 'closed' || data.counted_cash is number);
    }
    function wsPosOrderKeys(data) {
      return data.keys().hasOnly([
          'order_number', 'dimension_id', 'table_id', 'table_label', 'channel', 'status',
          'lines', 'subtotal', 'discount_amount', 'discount_reason', 'discount_total',
          'service_charge_amount', 'tax_amount', 'total_amount', 'payments', 'paid_amount',
          'note', 'version', 'opened_at', 'paid_at', 'voided_at', 'void_reason',
          'transaction_id', 'stock_adjustment_id', 'refund_transaction_id', 'refund_reason', 'refunded_at',
          'shift_id',
          // Who the order is for. Captured when the order is CREATED — a dine-in
          // needs a table and a cover count, a takeaway needs a way to call the
          // customer back. Every one is optional: a queue does not wait while a
          // cashier types a phone number.
          'customer_name', 'customer_phone', 'guest_count',
          'created_at', 'updated_at', 'created_by', 'updated_by'
        ]);
    }
    // Bounded scalars, checked in rules rather than only in the DAL.
    //
    // `lines[]` and `payments[]` are DAL-validated because rules cannot iterate
    // an array cheaply and the evaluation budget is real (the invoice open→paid
    // trip of 2026-07-14). These three are scalars: nine expressions, which the
    // lean POS validators can afford, and worth spending because they are the
    // only fields on this document a customer's own words reach.
    function wsValidPosOrderGuest(data) {
      return (!('customer_name' in data) || data.customer_name == null
          || (data.customer_name is string && data.customer_name.size() <= 80))
        && (!('customer_phone' in data) || data.customer_phone == null
          || (data.customer_phone is string && data.customer_phone.size() <= 32))
        && (!('guest_count' in data) || data.guest_count == null
          || (data.guest_count is int && data.guest_count >= 0 && data.guest_count <= 999));
    }
    function wsValidPosOrderCreate(data) {
      return wsPosOrderKeys(data)
        && wsValidPosOrderGuest(data)
        && data.dimension_id is string
        && data.channel in ['staff', 'qr', 'connector']
        && data.status in ['open', 'submitted']
        && data.lines is list
        && data.total_amount is number
        && data.version == 1
        && data.created_at == request.time;
    }
    // Open order. `version` must advance by exactly one — that is what makes a
    // stale second device lose the race instead of overwriting the first's lines.
    function wsValidPosOrderUpdate(data, prev) {
      return wsPosOrderKeys(data)
        && wsValidPosOrderGuest(data)
        && data.status in ['open', 'submitted', 'sent', 'served', 'awaiting_payment', 'paid', 'void']
        && data.version == prev.version + 1
        && data.dimension_id == prev.dimension_id
        && data.created_at == prev.created_at
        && data.total_amount is number
        && data.paid_amount is number
        // Paid is DERIVED, never asserted — else a client flips the flag and
        // emits revenue for an unpaid table.
        && (data.status != 'paid' || data.paid_amount >= data.total_amount)
        && (data.status != 'void' || (data.void_reason is string && data.void_reason.size() > 0));
    }
    // The ONE non-refund mutation a paid order still needs: stamping what it
    // emitted. `transaction_id` is the idempotency key, so this is write-ONCE —
    // `prev.transaction_id == null` is what stops a second emission overwriting
    // the first and double-booking the revenue.
    //
    // Without this, a paid order could not be stamped at all: the refund
    // validator demands a reason, so the stamp was refused, the order stayed
    // unmarked, and the next sweep emitted the sale a SECOND time. Two
    // transactions for one order, silently. Found 2026-08-21 walking a shift.
    function wsValidPosOrderStamp(data, prev) {
      return data.version == prev.version + 1
        && prev.transaction_id == null
        && data.transaction_id is string
        && data.status == prev.status
        && data.total_amount == prev.total_amount
        && data.paid_amount == prev.paid_amount
        && data.lines == prev.lines
        && data.dimension_id == prev.dimension_id;
    }
    // Paid orders are frozen except the refund trail: what was sold and for how
    // much must stay identical to what posted, or order and ledger silently part.
    function wsValidPosOrderRefund(data, prev) {
      return data.version == prev.version + 1
        && data.status in ['paid', 'void']
        && data.total_amount == prev.total_amount
        && data.paid_amount == prev.paid_amount
        && data.lines == prev.lines
        && data.dimension_id == prev.dimension_id
        && data.transaction_id == prev.transaction_id
        && data.refund_reason is string
        && data.refund_reason.size() > 0;
    }
    // Accounting kernel: a journal may only post into a period that is not closed
    // or locked. A missing period doc means the period has never been closed (open).
    // The closing journal itself is allowed because the period lock write commits
    // in the same batch — at rule-eval time the committed period is still open.
    function wsPeriodOpen(workspaceId, pk) {
      return pk is string
        && (!exists(/databases/$(database)/documents/workspaces/$(workspaceId)/periods/$(pk))
          || get(/databases/$(database)/documents/workspaces/$(workspaceId)/periods/$(pk)).data.status == 'open');
    }
    // Email-keyed invites: doc id == lowercased invitee email, so rules can
    // verify a self-join without a query.
    function callerEmail() {
      return (request.auth != null && request.auth.token.email is string)
        ? request.auth.token.email.lower() : '';
    }
    function invitePathFor(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/invites/$(callerEmail());
    }
    function hasPendingInvite(workspaceId) {
      return callerEmail() != ''
        && exists(invitePathFor(workspaceId))
        && get(invitePathFor(workspaceId)).data.status == 'pending';
    }
    function pendingInviteRole(workspaceId) {
      return get(invitePathFor(workspaceId)).data.role;
    }

    // Workspace ACCOUNTING currencies (docs/PROJECT_BACKGROUND.md §4). Rules cannot
    // cheaply assert the value equals THIS workspace's base_currency — a get() per
    // write costs a document read and adds to the expression budget, which this
    // ruleset has already exhausted once in production. So the tight check lives
    // in the client + tests/money-seam.check.js; rules bound the set.
    // NOT for FluxyOS's own billing, which stays IDR.
    function isWorkspaceCurrency(c) {
      return c in ['IDR', 'PHP', 'SGD', 'MYR'];
    }

    // Invoice/bill FACE currencies: every workspace accounting currency plus USD.
    // A business must be able to invoice in its OWN currency — this list omitted
    // PHP and MYR, so a Philippine workspace could not raise a peso invoice at all.
    // Mirrored by SUPPORTED in assets/js/money-format.js.
    function isFaceCurrency(c) {
      return c in ['IDR', 'USD', 'SGD', 'PHP', 'MYR'];
    }

    function isValidWorkspaceProfile(data) {
      return data.keys().hasOnly(['owner_uid', 'name', 'created_at', 'updated_at', 'plan_id', 'plan_name', 'subscription_status', 'billing_frequency', 'plan_synced_at', 'trial_started_at', 'trial_ends_at', 'current_period_end', 'country', 'base_currency', 'business_category'])
        && data.owner_uid is string
        && (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 120))
        // IMMUTABLE financial configuration, chosen at onboarding. The base
        // currency decides how every stored integer is interpreted, so changing
        // it after records exist re-prices history — see the set-once clause on
        // `allow update` below, which is the actual enforcement. This validator
        // only constrains the VALUE; hiding the control in the UI is not a
        // security boundary on a client-side Firestore app.
        && (!('country' in data) || data.country in ['ID', 'PH', 'SG', 'MY'])
        && (!('base_currency' in data) || data.base_currency in ['IDR', 'PHP', 'SGD', 'MYR'])
        // Declared line of business. Decides which operational modules the
        // workspace is offered; NOT set-once, because it re-prices nothing and a
        // business genuinely can change what it does. Owner-only in effect: the
        // `allow update` clause below restricts admins to name/updated_at.
        // Vocabulary mirrored in assets/js/business-category.js and db-service.js.
        && (!('business_category' in data) || data.business_category in ['fnb', 'startup', 'technology', 'manufacturing', 'retail', 'services', 'other'])
        // Denormalized, non-sensitive subscription summary (owner-written, member-read).
        // No amounts / payment details — just enough for every member to see the plan
        // and inherit the SAME trial state (timing + status only).
        && (!('plan_id' in data) || data.plan_id == null || (data.plan_id is string && data.plan_id.size() <= 40))
        && (!('plan_name' in data) || data.plan_name == null || (data.plan_name is string && data.plan_name.size() <= 80))
        && (!('subscription_status' in data) || data.subscription_status == null || (data.subscription_status is string && data.subscription_status.size() <= 40))
        && (!('billing_frequency' in data) || data.billing_frequency == null || (data.billing_frequency is string && data.billing_frequency.size() <= 20))
        && (!('plan_synced_at' in data) || data.plan_synced_at == null || data.plan_synced_at is timestamp)
        && (!('trial_started_at' in data) || data.trial_started_at == null || data.trial_started_at is timestamp)
        && (!('trial_ends_at' in data) || data.trial_ends_at == null || data.trial_ends_at is timestamp)
        && (!('current_period_end' in data) || data.current_period_end == null || data.current_period_end is timestamp);
    }
    // Invoice-email branding/customization (workspaces/{ws}/settings/invoice_email).
    // Non-sensitive presentation config only; read by any member, written by
    // owner/admin (editing UI is a follow-up). The backend also reads it via the
    // Admin SDK. No secrets, no formatted currency.
    function isValidInvoiceEmailSettings(data) {
      return data.keys().hasOnly(['sender_name', 'subject_template', 'message', 'logo_url', 'reply_to', 'updated_at', 'updated_by'])
        && (!('sender_name' in data) || data.sender_name == null || (data.sender_name is string && data.sender_name.size() <= 80))
        && (!('subject_template' in data) || data.subject_template == null || (data.subject_template is string && data.subject_template.size() <= 200))
        && (!('message' in data) || data.message == null || (data.message is string && data.message.size() <= 2000))
        && (!('logo_url' in data) || data.logo_url == null || (data.logo_url is string && data.logo_url.size() <= 500))
        && (!('reply_to' in data) || data.reply_to == null || (data.reply_to is string && data.reply_to.size() <= 200))
        && (!('updated_by' in data) || data.updated_by == null || data.updated_by == request.auth.uid);
    }
    function isValidMember(data) {
      return data.keys().hasOnly(['uid', 'email', 'display_name', 'role', 'status', 'invited_by', 'joined_at', 'updated_at'])
        && data.uid is string
        && data.role in ['owner', 'admin', 'finance', 'accountant', 'viewer', 'cashier']
        && data.status in ['active', 'pending', 'removed']
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200))
        && (!('display_name' in data) || data.display_name == null || (data.display_name is string && data.display_name.size() <= 200))
        && (!('invited_by' in data) || data.invited_by == null || (data.invited_by is string && data.invited_by.size() <= 160));
    }
    function isValidInvite(inviteId, data) {
      return data.keys().hasOnly(['email', 'role', 'status', 'invited_by', 'invited_by_email', 'created_at', 'updated_at', 'expires_at', 'accepted_by', 'accepted_at'])
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.email == inviteId
        && data.role in ['admin', 'finance', 'accountant', 'viewer', 'cashier']
        && data.status in ['pending', 'accepted', 'revoked', 'expired']
        && (!('invited_by' in data) || data.invited_by == null || (data.invited_by is string && data.invited_by.size() <= 160))
        && (!('invited_by_email' in data) || data.invited_by_email == null || (data.invited_by_email is string && data.invited_by_email.size() <= 200))
        && (!('expires_at' in data) || data.expires_at == null || data.expires_at is timestamp);
    }
    function isValidWorkspaceAuditLog(data) {
      return data.keys().hasAll(['actor_uid', 'action', 'target_collection', 'target_id', 'source', 'created_at'])
        && data.actor_uid == request.auth.uid
        && data.action is string && data.action.size() > 0 && data.action.size() <= 80
        && data.target_collection in [
          'transactions', 'bills', 'subscriptions', 'vendors', 'budgets',
          'budget_allocations', 'invoices', 'exports', 'report_exports',
          'members', 'invites', 'workspace', 'settings', 'integrations', 'users',
          'onboarding', 'bank_accounts', 'bank_balance_snapshots',
          'bank_statement_imports', 'documents', 'billing',
          'billing_payment_requests', 'payment_verifications', 'accounting_mappings',
          'chart_of_accounts', 'journals', 'ledger_balances', 'periods', 'counters',
          'company_tax_profile', 'tax_mappings', 'tax_transactions', 'tax_periods', 'tax_filings',
          'commerce_accounts', 'commerce_orders', 'commerce_transactions', 'commerce_refunds',
          'commerce_settlements', 'commerce_payouts', 'commerce_sync_jobs',
          'commerce_sync_errors', 'commerce_webhook_logs', 'duplicate_reviews',
          'dimensions', 'ledger_balances_by_dim', 'items',
          'goods_receipts', 'stock_movements', 'stock_adjustments'
        ]
        && data.target_id is string && data.target_id.size() <= 200
        && data.source in ['dashboard', 'ai', 'integration', 'system', 'onboarding']
        && data.created_at == request.time;
    }

    // ---- STAGE 2 finance-record validation (workspace scope) ----
    // Reuse the pure field validators defined above; for the collections whose
    // user-scoped blocks inline a keys().hasOnly([...]) allow-list, these helpers
    // hold a verbatim copy so the workspace blocks enforce identical shape.
    function invoiceIsDraftAfterWriteWs(workspaceId, invoiceId) {
      let inv = getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/invoices/$(invoiceId)).data;
      return inv.status == 'draft'
        || (inv.status == 'open' && (!('sent_at' in inv) || inv.sent_at == null));
    }
    // Accounting kernel back-link: the posting engine stamps these onto the source
    // transaction/bill/subscription so the document can drill to its journal and
    // surface its posting status. Optional + bounded.
    function isValidAccountingLink(data) {
      return (!('journal_ref' in data) || data.journal_ref == null || (data.journal_ref is string && data.journal_ref.size() <= 120))
        && (!('accounting_status' in data) || data.accounting_status in ['posted', 'pending', 'excluded', 'reversed']);
    }

    // The optional Chart-of-Accounts link a transaction/bill/subscription carries
    // when the user picks (or the engine resolves) a categorizing account in the
    // entry drawer: account_code (CoA code) + account_name (display). Optional +
    // bounded. Kept SEPARATE from isValidAccountingLink so the budget-sensitive
    // invoice validator (which never carries account_code) stays lean and does not
    // trip the rules-evaluation budget on tax-carrying invoices.
    function isValidAccountLink(data) {
      return (!('account_code' in data) || data.account_code == null || (data.account_code is string && data.account_code.size() <= 12))
        && (!('account_name' in data) || data.account_name == null || (data.account_name is string && data.account_name.size() <= 80));
    }

    // Commerce Integration back-links: the server-side sync worker stamps these
    // onto ledger transactions it creates (source:'commerce') so the doc can
    // drill to its commerce_orders / commerce_accounts records. Optional +
    // bounded. See docs/COMMERCE_INTEGRATION_PHASE0_REVIEW.md D2.
    function isValidCommerceLink(data) {
      return (!('commerce_order_id' in data) || data.commerce_order_id == null || (data.commerce_order_id is string && data.commerce_order_id.size() <= 200))
        && (!('commerce_account_id' in data) || data.commerce_account_id == null || (data.commerce_account_id is string && data.commerce_account_id.size() <= 200));
    }
    // Tax Center per-document tax fields (optional, bounded). Allowed on
    // transactions/bills/invoices so a document can carry its own PPN treatment.
    function isValidTaxDocFields(data) {
      return (!('tax_code' in data) || data.tax_code == null || (data.tax_code is string && data.tax_code.size() <= 40))
        && (!('tax_rate_percent' in data) || data.tax_rate_percent == null || (data.tax_rate_percent is number && data.tax_rate_percent >= 0 && data.tax_rate_percent <= 100))
        && (!('tax_amount' in data) || data.tax_amount == null || (data.tax_amount is number && data.tax_amount >= 0))
        && (!('taxable_base' in data) || data.taxable_base == null || (data.taxable_base is number && data.taxable_base >= 0))
        && (!('vendor_npwp' in data) || data.vendor_npwp == null || (data.vendor_npwp is string && data.vendor_npwp.size() <= 32))
        && (!('faktur_number' in data) || data.faktur_number == null || (data.faktur_number is string && data.faktur_number.size() <= 40))
        && (!('withholding_rate' in data) || data.withholding_rate == null || (data.withholding_rate is number && data.withholding_rate >= 0 && data.withholding_rate <= 100))
        && (!('withholding_type' in data) || data.withholding_type == null || (data.withholding_type is string && data.withholding_type.size() <= 40))
        && (!('withholding_code' in data) || data.withholding_code == null || (data.withholding_code is string && data.withholding_code.size() <= 40))
        && (!('bukti_potong_no' in data) || data.bukti_potong_no == null || (data.bukti_potong_no is string && data.bukti_potong_no.size() <= 60))
        && (!('customer_npwp' in data) || data.customer_npwp == null || (data.customer_npwp is string && data.customer_npwp.size() <= 32))
        && (!('customer_withholding_amount' in data) || data.customer_withholding_amount == null || (data.customer_withholding_amount is number && data.customer_withholding_amount >= 0))
        && (!('customer_withholding_rate' in data) || data.customer_withholding_rate == null || (data.customer_withholding_rate is number && data.customer_withholding_rate >= 0 && data.customer_withholding_rate <= 100))
        && (!('customer_withholding_type' in data) || data.customer_withholding_type == null || (data.customer_withholding_type is string && data.customer_withholding_type.size() <= 40))
        && (!('customer_withholding_code' in data) || data.customer_withholding_code == null || (data.customer_withholding_code is string && data.customer_withholding_code.size() <= 40));
    }
    function wsValidTxCreate(data) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'timestamp',
          'created_at', 'receipt_url', 'attached_documents', 'source', 'created_via',
          'extraction_status', 'extraction_source', 'extraction_confidence', 'extraction_warnings',
          'document_type', 'invoice_number', 'invoice_date', 'raw_text_preview',
          'source_file_name', 'source_file_mime_type', 'source_file_size_bytes',
          'payment_reference', 'notes', 'budget_id', 'budget_allocation_id', 'budget_match_method',
          'budget_match_status', 'budget_match_confidence', 'budget_assignment_reason',
          'budget_assignment_updated_at', 'budget_assignment_updated_by', 'budget_exclusion_reason',
          'cash_effective', 'cash_status', 'cash_direction', 'cash_account_id', 'cash_source',
          'cash_match_status', 'cash_effective_at', 'bank_statement_import_id', 'bank_statement_row_id',
          'imported_at', 'bank_account_id', 'recon_status', 'recon_import_id', 'recon_row_id', 'recon_at',
          'linked_bill_id', 'linked_invoice_id',
          'journal_ref', 'accounting_status', 'account_code', 'account_name', 'commerce_order_id', 'commerce_account_id',
          // POS. pos_discount_amount lets POS-SALE credit revenue GROSS and debit
          // the discount to 4900; folded into the price it is lost forever.
          'pos_order_id', 'pos_discount_amount', 'pos_discount_reason', 'pos_settlement', 'pos_refund_reason',
          'pos_cash_amount', 'pos_clearing_amount',
          'tax_code', 'tax_rate_percent', 'tax_amount', 'taxable_base', 'vendor_npwp', 'faktur_number',
          'withholding_rate', 'withholding_type', 'withholding_code', 'bukti_potong_no',
          'customer_npwp', 'customer_withholding_amount', 'customer_withholding_rate',
          'customer_withholding_type', 'customer_withholding_code',
          // Outlet/branch this record belongs to. buildJournal stamps it onto
          // every line it produces, which is what lets /outlet-pnl attribute
          // revenue. Allowed on UPDATE too, or editing a record would strip it.
          'dimension_id'
        ])
        && isValidBaseRecord(data)
        && (!('created_at' in data) || data.created_at == request.time)
        && (!('receipt_url' in data) || data.receipt_url is string)
        && (!('linked_bill_id' in data) || data.linked_bill_id == null || (data.linked_bill_id is string && data.linked_bill_id.size() <= 120))
        && isValidTransactionBudgetFields(data)
        && isValidAttachedDocuments(data)
        && isValidAccountingLink(data)
        && isValidAccountLink(data)
        && isValidCommerceLink(data)
        && isValidTaxDocFields(data)
        && isValidAICaptureMetadata(data);
    }
    function wsValidTxUpdate(data, existingData) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'date', 'timestamp',
          'created_at', 'receipt_url', 'attached_documents', 'source', 'created_via',
          'extraction_status', 'extraction_source', 'extraction_confidence', 'extraction_warnings',
          'document_type', 'invoice_number', 'invoice_date', 'raw_text_preview',
          'source_file_name', 'source_file_mime_type', 'source_file_size_bytes',
          'payment_reference', 'notes', 'budget_id', 'budget_allocation_id', 'budget_match_method',
          'budget_match_status', 'budget_match_confidence', 'budget_assignment_reason',
          'budget_assignment_updated_at', 'budget_assignment_updated_by', 'budget_exclusion_reason',
          'cash_effective', 'cash_status', 'cash_direction', 'cash_account_id', 'cash_source',
          'cash_match_status', 'cash_effective_at', 'cash_assignment_reason', 'cash_assignment_updated_at',
          'cash_assignment_updated_by', 'updated_at', 'updated_by', 'is_voided', 'voided_at', 'voided_by',
          'void_reason', 'bank_statement_import_id', 'bank_statement_row_id', 'imported_at',
          'bank_account_id', 'recon_status', 'recon_import_id', 'recon_row_id', 'recon_at',
          'linked_bill_id', 'linked_invoice_id', 'journal_ref', 'accounting_status', 'account_code', 'account_name',
          'commerce_order_id', 'commerce_account_id',
          // POS. pos_discount_amount lets POS-SALE credit revenue GROSS and debit
          // the discount to 4900; folded into the price it is lost forever.
          'pos_order_id', 'pos_discount_amount', 'pos_discount_reason', 'pos_settlement', 'pos_refund_reason',
          'pos_cash_amount', 'pos_clearing_amount',
          'tax_code', 'tax_rate_percent', 'tax_amount', 'taxable_base', 'vendor_npwp', 'faktur_number',
          'withholding_rate', 'withholding_type', 'withholding_code', 'bukti_potong_no',
          'customer_npwp', 'customer_withholding_amount', 'customer_withholding_rate',
          'customer_withholding_type', 'customer_withholding_code',
          // Outlet/branch this record belongs to. buildJournal stamps it onto
          // every line it produces, which is what lets /outlet-pnl attribute
          // revenue. Allowed on UPDATE too, or editing a record would strip it.
          'dimension_id'
        ])
        && isValidTransactionRecordUpdate(data, existingData)
        && preservesLegacyRecordDate(data, existingData)
        && (!('linked_bill_id' in data) || data.linked_bill_id == null || (data.linked_bill_id is string && data.linked_bill_id.size() <= 120))
        && isValidTransactionBudgetFields(data)
        && isValidAttachedDocuments(data)
        && isValidAccountingLink(data)
        && isValidAccountLink(data)
        && isValidCommerceLink(data)
        && isValidTaxDocFields(data)
        && isValidAICaptureMetadata(data);
    }
    // Bill optional-field groups, gated on PRESENCE.
    //
    // Firestore evaluates at most 1000 expressions per request and re-validates
    // the whole document, so a validator that walks every optional field of
    // every feature ever shipped (budget + accounting + AI capture + tax +
    // multi-currency) exceeds the ceiling on an ordinary bill — measured at 26
    // keys, which a scanned bill with a budget passes easily. The write then
    // fails as "Missing or insufficient permissions".
    //
    // hasAny() costs one call, so a bill that carries none of a group skips that
    // group's checks entirely. The checks themselves are unchanged when the
    // fields ARE present; this buys headroom without loosening anything.

    // Capture metadata for BILLS, written lean.
    //
    // Every enum and every size cap from isValidAICaptureMetadata is kept — they
    // are what protect the state machine and guard against storage abuse. What
    // is dropped are the bare `is string` checks on provenance fields
    // (extraction_source, document_type, invoice_number, source_file_name,
    // source_file_mime_type): hasOnly() already bounds WHICH keys may exist and
    // Firestore bounds the document to 1 MiB, so a type assertion on a filename
    // buys almost nothing — and each one costs ~10 of the 1000 expressions a
    // request gets. Bills accumulate more optional fields than any other record,
    // so they are the only shape where this trade is needed; transactions and
    // subscriptions keep the fuller validator.
    function billCaptureValid(data) {
      return (!('source' in data) || data.source in ['bill_scan', 'transaction_scan', 'subscription_scan', 'bank_statement_import', 'csv_import'])
        && (!('created_via' in data) || data.created_via in ['ai_bill_capture', 'ai_transaction_capture', 'ai_subscription_capture'])
        && (!('extraction_status' in data) || data.extraction_status == 'reviewed')
        && (!('extraction_confidence' in data) || data.extraction_confidence == null || data.extraction_confidence is number)
        && (!('extraction_warnings' in data) || data.extraction_warnings is list)
        && (!('invoice_date' in data) || data.invoice_date is timestamp)
        && (!('raw_text_preview' in data) || data.raw_text_preview == null || data.raw_text_preview.size() <= 500)
        && (!('source_file_size_bytes' in data) || data.source_file_size_bytes == null || data.source_file_size_bytes is number)
        && (!('notes' in data) || data.notes == null || data.notes.size() <= 1000);
    }

    // Tax fields for BILLS, written lean.
    //
    // Every RANGE and every size cap is kept — those guard the tax arithmetic and
    // the faktur/NPWP strings. What is dropped are the separate `is string` /
    // `is number` assertions: `.size()` on a non-string and `>=` on a
    // non-number both error, and an erroring rule DENIES, so the type is still
    // enforced — just in two fewer expressions per field. See billCaptureValid
    // for why bills specifically need this.
    function billTaxValid(data) {
      return (!('tax_code' in data) || data.tax_code == null || data.tax_code.size() <= 40)
        && (!('tax_rate_percent' in data) || data.tax_rate_percent == null || (data.tax_rate_percent >= 0 && data.tax_rate_percent <= 100))
        && (!('tax_amount' in data) || data.tax_amount == null || data.tax_amount >= 0)
        && (!('taxable_base' in data) || data.taxable_base == null || data.taxable_base >= 0)
        && (!('vendor_npwp' in data) || data.vendor_npwp == null || data.vendor_npwp.size() <= 32)
        && (!('faktur_number' in data) || data.faktur_number == null || data.faktur_number.size() <= 40)
        && (!('withholding_rate' in data) || data.withholding_rate == null || (data.withholding_rate >= 0 && data.withholding_rate <= 100))
        && (!('withholding_type' in data) || data.withholding_type == null || data.withholding_type.size() <= 40)
        && (!('withholding_code' in data) || data.withholding_code == null || data.withholding_code.size() <= 40)
        && (!('bukti_potong_no' in data) || data.bukti_potong_no == null || data.bukti_potong_no.size() <= 60);
    }

    // Budget + payment fields for BILLS, written lean (see billCaptureValid).
    // Enums, ranges and caps kept; redundant type assertions dropped, since
    // `.size()` / comparison on the wrong type errors and an erroring rule denies.
    function billBudgetValid(data) {
      return (!('budget_id' in data) || data.budget_id == null || data.budget_id.size() <= 120)
        && (!('budget_allocation_id' in data) || data.budget_allocation_id == null || data.budget_allocation_id.size() <= 120)
        && (!('budget_match_method' in data) || data.budget_match_method == null || data.budget_match_method in ['auto', 'manual', 'rule', 'excluded', 'none'])
        && (!('budget_match_status' in data) || data.budget_match_status == null || data.budget_match_status in ['matched', 'needs_review', 'unmatched', 'excluded'])
        && (!('budget_impact_status' in data) || data.budget_impact_status == null || data.budget_impact_status in ['committed', 'released', 'converted_to_actual'])
        && (!('budget_assignment_reason' in data) || data.budget_assignment_reason == null || data.budget_assignment_reason.size() <= 500)
        && (!('budget_assignment_updated_at' in data) || data.budget_assignment_updated_at == null || data.budget_assignment_updated_at is timestamp)
        && (!('budget_assignment_updated_by' in data) || data.budget_assignment_updated_by == null || data.budget_assignment_updated_by == request.auth.uid)
        && (!('budget_exclusion_reason' in data) || data.budget_exclusion_reason == null || data.budget_exclusion_reason.size() <= 500);
    }
    function billPaymentValid(data) {
      return (!('bill_number' in data) || data.bill_number == null || data.bill_number.size() <= 40)
        && (!('outstanding_amount' in data) || data.outstanding_amount == null || (data.outstanding_amount >= 0 && data.outstanding_amount <= 999999999999))
        && (!('amount_paid' in data) || data.amount_paid == null || (data.amount_paid >= 0 && data.amount_paid <= 999999999999))
        && (!('currency' in data) || isFaceCurrency(data.currency))
        && (!('amount_paid_idr' in data) || data.amount_paid_idr == null || data.amount_paid_idr >= 0)
        && (!('fx_rate' in data) || data.fx_rate == null || data.fx_rate is number)
        && (!('fx_rate_date' in data) || data.fx_rate_date == null || data.fx_rate_date.size() <= 20);
    }

    // Every optional bill field, validated flat and WITHOUT a null branch.
    //
    // Used on CREATE only. addBill strips null optional fields before writing
    // (a null on a create can never mean anything a missing key does not), so
    // the `x == null ||` branch every other validator carries is dead weight
    // here — and dead weight is what exhausts the 1000-expression budget on a
    // bill carrying budget + accounting + AI capture + PPN + PPh withholding.
    //
    // Flat on purpose: no helper calls, no presence gates. Gates only pay off
    // when a group is absent, and the shape this exists to rescue has them all.
    //
    // Enums, ranges and size caps are identical to the update-side validators.
    // `.size()` on a non-string and a comparison on a non-number both error, and
    // an erroring rule DENIES — so types stay enforced without asserting them.
    function billOptionalsCreateValid(data) {
      return (!('due_date' in data) || data.due_date is timestamp)
        && (!('payment_status' in data) || data.payment_status in ['unpaid', 'paid', 'partial', 'overdue', 'unknown'])
        && (!('invoice_status' in data) || data.invoice_status == 'attached')
        && (!('attached_documents' in data) || (data.attached_documents is list && data.attached_documents.size() <= 20))
        && (!('journal_ref' in data) || data.journal_ref.size() <= 120)
        && (!('accounting_status' in data) || data.accounting_status in ['posted', 'pending', 'excluded', 'reversed'])
        && (!('account_code' in data) || data.account_code.size() <= 20)
        && (!('account_name' in data) || data.account_name.size() <= 120)
        && (!('budget_id' in data) || data.budget_id.size() <= 120)
        && (!('budget_allocation_id' in data) || data.budget_allocation_id.size() <= 120)
        && (!('budget_match_method' in data) || data.budget_match_method in ['auto', 'manual', 'rule', 'excluded', 'none'])
        && (!('budget_match_status' in data) || data.budget_match_status in ['matched', 'needs_review', 'unmatched', 'excluded'])
        && (!('budget_impact_status' in data) || data.budget_impact_status in ['committed', 'released', 'converted_to_actual'])
        && (!('budget_assignment_reason' in data) || data.budget_assignment_reason.size() <= 500)
        && (!('budget_assignment_updated_at' in data) || data.budget_assignment_updated_at is timestamp)
        && (!('budget_assignment_updated_by' in data) || data.budget_assignment_updated_by == request.auth.uid)
        && (!('budget_exclusion_reason' in data) || data.budget_exclusion_reason.size() <= 500)
        && (!('bill_number' in data) || data.bill_number.size() <= 40)
        && (!('outstanding_amount' in data) || (data.outstanding_amount >= 0 && data.outstanding_amount <= 999999999999))
        && (!('amount_paid' in data) || (data.amount_paid >= 0 && data.amount_paid <= 999999999999))
        && (!('currency' in data) || isFaceCurrency(data.currency))
        && (!('amount_paid_idr' in data) || data.amount_paid_idr >= 0)
        && (!('fx_rate' in data) || data.fx_rate is number)
        && (!('fx_rate_date' in data) || data.fx_rate_date.size() <= 20)
        && (!('tax_code' in data) || data.tax_code.size() <= 40)
        && (!('tax_rate_percent' in data) || (data.tax_rate_percent >= 0 && data.tax_rate_percent <= 100))
        && (!('tax_amount' in data) || data.tax_amount >= 0)
        && (!('taxable_base' in data) || data.taxable_base >= 0)
        && (!('vendor_npwp' in data) || data.vendor_npwp.size() <= 32)
        && (!('faktur_number' in data) || data.faktur_number.size() <= 40)
        && (!('withholding_rate' in data) || (data.withholding_rate >= 0 && data.withholding_rate <= 100))
        && (!('withholding_type' in data) || data.withholding_type.size() <= 40)
        && (!('withholding_code' in data) || data.withholding_code.size() <= 40)
        && (!('bukti_potong_no' in data) || data.bukti_potong_no.size() <= 60)
        && (!('source' in data) || data.source in ['bill_scan', 'transaction_scan', 'subscription_scan', 'bank_statement_import', 'scan'])
        && (!('created_via' in data) || data.created_via in ['ai_bill_capture', 'ai_transaction_capture', 'ai_subscription_capture', 'ai_bill_scan'])
        && (!('extraction_status' in data) || data.extraction_status == 'reviewed')
        && (!('extraction_confidence' in data) || data.extraction_confidence is number)
        && (!('extraction_warnings' in data) || data.extraction_warnings is list)
        && (!('invoice_date' in data) || data.invoice_date is timestamp)
        && (!('raw_text_preview' in data) || data.raw_text_preview.size() <= 500)
        && (!('source_file_size_bytes' in data) || data.source_file_size_bytes >= 0);
    }

    function wsValidBillCreate(data) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'timestamp', 'due_date',
          'source', 'created_via', 'extraction_status', 'extraction_source', 'extraction_confidence',
          'extraction_warnings', 'document_type', 'invoice_number', 'invoice_date', 'payment_status',
          'raw_text_preview', 'source_file_name', 'source_file_mime_type', 'source_file_size_bytes',
          'attached_documents', 'invoice_status', 'budget_id', 'budget_allocation_id',
          'budget_match_method', 'budget_match_status', 'budget_impact_status', 'budget_assignment_reason',
          'budget_assignment_updated_at', 'budget_assignment_updated_by', 'budget_exclusion_reason',
          'journal_ref', 'accounting_status', 'account_code', 'account_name',
          'bill_number', 'outstanding_amount', 'amount_paid', 'currency', 'amount_paid_idr', 'fx_rate', 'fx_rate_date',
          'tax_code', 'tax_rate_percent', 'tax_amount', 'taxable_base', 'vendor_npwp', 'faktur_number',
          'withholding_rate', 'withholding_type', 'withholding_code', 'bukti_potong_no',
          'dimension_id'
        ])
        && isValidBaseRecord(data)
        && billOptionalsCreateValid(data);
    }
    // A bill PAYMENT touches a fixed, tiny set of keys. It is evaluated FIRST and
    // deliberately WITHOUT the full bill update validator.
    //
    // wsValidBillUpdate is a 57-key hasOnly plus ten sub-validators, and Firestore
    // re-validates the ENTIRE resulting document on an update — so a real
    // production bill carrying budget + tax + withholding + attachment + currency
    // fields exhausts the rules evaluation budget and comes back as
    // "Missing or insufficient permissions". Emulator fixtures are lean enough to
    // pass, which is why this only ever bites in production.
    //
    // Same failure and same remedy as isValidInvoicePaidTransition (invoice
    // open -> paid, 2026-07-14). Keep this validator flat: no helper calls.
    function isValidBillPayTransition(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly([
          'amount_paid', 'outstanding_amount', 'payment_status',
          'budget_impact_status', 'linked_transaction_id',
          'amount_paid_idr', 'fx_rate', 'fx_rate_date',
          'updated_at', 'updated_by'
        ])
        // 'unpaid' is here for the VOID ROLLBACK, not for a pay: voiding a bill
        // payment reverses its journal, so the bill has to give the settlement
        // back, and voiding the last payment lands on 'unpaid'.
        //
        // It must be accepted by THIS lean validator rather than falling through
        // to wsValidBillUpdate. That fallback does work on a plain bill, but it
        // validates the whole document and lands within sight of the 1000-
        // expression evaluation ceiling — the emulator already reports exhaustion
        // on this path. A tax-carrying bill would therefore deny a legitimate
        // rollback with permission-denied, which is the failure mode
        // isValidInvoicePaidTransition was created to escape (§ invoices).
        //
        // Widening the enum is safe: the diff is still restricted to the payment
        // keys above and the amounts must still be non-negative numbers.
        && data.payment_status in ['paid', 'partial', 'unpaid']
        && data.amount_paid is number && data.amount_paid >= 0
        && data.outstanding_amount is number && data.outstanding_amount >= 0
        && (!('budget_impact_status' in data) || data.budget_impact_status in ['committed', 'released', 'converted_to_actual'])
        && (!('linked_transaction_id' in data) || data.linked_transaction_id == null || (data.linked_transaction_id is string && data.linked_transaction_id.size() <= 120))
        && (!('amount_paid_idr' in data) || data.amount_paid_idr == null || (data.amount_paid_idr is number && data.amount_paid_idr >= 0))
        && (!('fx_rate' in data) || data.fx_rate == null || data.fx_rate is number)
        && (!('fx_rate_date' in data) || data.fx_rate_date == null || (data.fx_rate_date is string && data.fx_rate_date.size() <= 20))
        && data.updated_by is string && data.updated_by.size() <= 128;
    }

    function wsValidBillUpdate(data, existingData) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'timestamp', 'date', 'due_date',
          'source', 'created_via', 'extraction_status', 'extraction_source', 'extraction_confidence',
          'extraction_warnings', 'document_type', 'invoice_number', 'invoice_date', 'payment_status',
          'raw_text_preview', 'source_file_name', 'source_file_mime_type', 'source_file_size_bytes',
          'attached_documents', 'invoice_status', 'budget_id', 'budget_allocation_id',
          'budget_match_method', 'budget_match_status', 'budget_impact_status', 'budget_assignment_reason',
          'budget_assignment_updated_at', 'budget_assignment_updated_by', 'budget_exclusion_reason',
          'linked_transaction_id', 'updated_at', 'updated_by', 'journal_ref', 'accounting_status', 'account_code', 'account_name',
          'bill_number', 'outstanding_amount', 'amount_paid', 'currency', 'amount_paid_idr', 'fx_rate', 'fx_rate_date',
          'tax_code', 'tax_rate_percent', 'tax_amount', 'taxable_base', 'vendor_npwp', 'faktur_number',
          'withholding_rate', 'withholding_type', 'withholding_code', 'bukti_potong_no',
          'dimension_id'
        ])
        && isValidBaseRecordUpdate(data, existingData)
        && billTaxValid(data)
        && preservesLegacyRecordDate(data, existingData)
        && (!('due_date' in data) || data.due_date is timestamp)
        && (!('payment_status' in data) || data.payment_status in ['unpaid', 'paid', 'partial', 'overdue', 'unknown'])
        && (!('invoice_status' in data) || data.invoice_status in ['attached'])
        && (!('linked_transaction_id' in data) || data.linked_transaction_id == null || (data.linked_transaction_id is string && data.linked_transaction_id.size() <= 120))
        && billBudgetValid(data)
        && billPaymentValid(data)
        && isValidAttachedDocuments(data)
        && isValidAccountingLink(data)
        && isValidAccountLink(data)
        && billCaptureValid(data);
    }
    function wsValidSubCreate(data) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'timestamp', 'renewal_date',
          'source', 'created_via', 'extraction_status', 'extraction_source', 'extraction_confidence',
          'extraction_warnings', 'document_type', 'invoice_number', 'invoice_date', 'billing_cycle',
          'raw_text_preview', 'source_file_name', 'source_file_mime_type', 'source_file_size_bytes',
          'notes', 'attached_documents', 'journal_ref', 'accounting_status', 'account_code', 'account_name',
          'dimension_id'
        ])
        && isValidBaseRecord(data)
        && (!('renewal_date' in data) || data.renewal_date is timestamp)
        && isValidAttachedDocuments(data)
        && isValidAccountingLink(data)
        && isValidAccountLink(data)
        && isValidAICaptureMetadata(data);
    }
    function wsValidSubUpdate(data, existingData) {
      return data.keys().hasOnly([
          'amount', 'vendor_name', 'category', 'type', 'status', 'icon', 'timestamp', 'renewal_date',
          'source', 'created_via', 'extraction_status', 'extraction_source', 'extraction_confidence',
          'extraction_warnings', 'document_type', 'invoice_number', 'invoice_date', 'billing_cycle',
          'raw_text_preview', 'source_file_name', 'source_file_mime_type', 'source_file_size_bytes',
          'notes', 'attached_documents', 'journal_ref', 'accounting_status', 'account_code', 'account_name',
          'dimension_id'
        ])
        && isValidBaseRecordUpdate(data, existingData)
        && (!('renewal_date' in data) || data.renewal_date is timestamp)
        && isValidAttachedDocuments(data)
        && isValidAccountingLink(data)
        && isValidAccountLink(data)
        && isValidAICaptureMetadata(data);
    }
    function wsValidReportExportCreate(data) {
      return data.keys().hasOnly([
          'report_type', 'report_scope', 'period_start', 'period_end', 'formats', 'status',
          'included_sections', 'record_counts', 'warning_counts', 'limitations', 'created_at', 'created_by'
        ])
        && data.report_type is string && data.report_type.size() > 0 && data.report_type.size() <= 80
        && data.created_by == request.auth.uid
        && data.created_at == request.time
        && data.formats is list
        && data.status is string
        && data.included_sections is list
        && data.record_counts is map
        && data.warning_counts is map
        && data.limitations is list
        && (!('report_scope' in data) || data.report_scope is map);
    }

    // Collection-group read: a user may read their OWN membership docs across all
    // workspaces (doc.uid == caller). Authorizes the workspace-resolution query
    // collectionGroup('members').where('uid','==', uid) so members resolve their
    // workspace even without the reverse-lookup pointer. Scoped to own docs only.
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /workspaces/{workspaceId} {
      // Members can read the workspace; an owner can also read their own (id==uid)
      // workspace to bootstrap it before their member doc exists.
      allow read: if isMember(workspaceId)
        || (isSignedIn() && workspaceId == request.auth.uid);
      // Bootstrap: a user may only create their own workspace (id == uid).
      allow create: if isSignedIn()
        && workspaceId == request.auth.uid
        && isValidWorkspaceProfile(request.resource.data)
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.created_at == request.time;
      // Owner/admin may edit the profile name; owner_uid is immutable. The
      // denormalized subscription fields are OWNER-ONLY (they mirror the owner's
      // billing) — admins may only change name/updated_at.
      allow update: if wsAdmin(workspaceId)
        && isValidWorkspaceProfile(request.resource.data)
        && request.resource.data.owner_uid == resource.data.owner_uid
        // SET-ONCE. Absent -> value is allowed (onboarding writes it, and an
        // existing workspace can be stamped once); value -> different value is
        // refused forever, for owners too. The base currency is how every stored
        // integer is READ, so changing it after any record exists silently
        // re-prices history. A legitimate change goes through /internal with the
        // Admin SDK, which these rules do not gate.
        && (!('base_currency' in resource.data)
          || request.resource.data.base_currency == resource.data.base_currency)
        && (!('country' in resource.data)
          || request.resource.data.country == resource.data.country)
        && (hasRole(workspaceId, ['owner'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updated_at']));
      // Workspace deletion is an owner-only sensitive action handled server-side.
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(workspaceId)
          || (isSignedIn() && workspaceId == request.auth.uid && memberId == request.auth.uid);
        // (a) Owner bootstrap of their own membership.
        allow create: if isSignedIn()
          && workspaceId == request.auth.uid
          && memberId == request.auth.uid
          && isValidMember(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'owner'
          && request.resource.data.status == 'active'
        // (b) Owner/admin adds a member directly (never another owner).
          || wsAdmin(workspaceId)
          && isValidMember(request.resource.data)
          && request.resource.data.uid == memberId
          && request.resource.data.role in ['admin', 'finance', 'accountant', 'viewer']
        // (c) Invite acceptance: the invitee self-joins from a pending invite
          || isSignedIn()
          && memberId == request.auth.uid
          && isValidMember(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'active'
          && hasPendingInvite(workspaceId)
          && request.resource.data.role == pendingInviteRole(workspaceId);
        // Role changes are OWNER-ONLY. Admins cannot change roles. No one may edit
        // their OWN membership (no self-escalation), the owner doc is immutable
        // here, and no one can be promoted to owner (ownership transfer is a
        // separate server-side flow).
        allow update: if hasRole(workspaceId, ['owner'])
          && memberId != request.auth.uid
          && isValidMember(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role != 'owner'
          && resource.data.role != 'owner';
        // Removal is OWNER-ONLY, never self, never the owner. (Admins cannot remove
        // members; members cannot remove themselves.)
        allow delete: if hasRole(workspaceId, ['owner'])
          && memberId != request.auth.uid
          && resource.data.role != 'owner';
      }

      match /invites/{inviteId} {
        // Owner/admin manage invites; an invitee may read their own invite by id.
        allow read: if wsAdmin(workspaceId)
          || (isSignedIn() && resource.data.email == callerEmail());
        allow create: if wsAdmin(workspaceId)
          && isValidInvite(inviteId, request.resource.data)
          && request.resource.data.status == 'pending'
          && request.resource.data.created_at == request.time;
        // Owner/admin update (revoke/resend); OR the invitee flips pending->accepted.
        allow update: if (wsAdmin(workspaceId)
            && isValidInvite(inviteId, request.resource.data))
          || (isSignedIn()
            && resource.data.email == callerEmail()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'accepted_by', 'accepted_at', 'updated_at'])
            && request.resource.data.accepted_by == request.auth.uid);
        allow delete: if wsAdmin(workspaceId);
      }

      match /audit_logs/{auditLogId} {
        allow read: if wsAdmin(workspaceId);
        allow create: if isMember(workspaceId)
          && isValidWorkspaceAuditLog(request.resource.data);
        allow update, delete: if false;
      }

      // Duplicate decisions (docs/DUPLICATE_PREVENTION.md). Readable by every
      // member so a viewer understands why two similar records both exist;
      // writable by the same roles that can create the records. Never deleted.
      match /duplicate_reviews/{reviewId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId)
          && isValidDuplicateReview(request.resource.data)
          && request.resource.data.decided_at == request.time;
        allow update: if wsWrite(workspaceId)
          && isValidDuplicateReviewUpdate(request.resource.data, resource.data)
          && request.resource.data.decided_at == request.time;
        allow delete: if false;
      }

      // ---- STAGE 2 finance/operational records (role-gated) ----
      // read: any active member incl. viewer · create/update: owner/admin/finance
      // · delete/void: owner/admin (most use status changes, not deletes).
      match /transactions/{transactionId} {
        // No 'cashier' on read — deliberate. Their figures come from pos_orders.
        allow read: if wsRead(workspaceId);
        // Two independent clauses, not one shared validator: see wsValidPosTxCreate.
        // 'pending' because a cashier cannot write journals — an inline attempt
        // would fail the whole atomic batch; a finance session sweeps them later.
        allow create: if (wsWrite(workspaceId)
            && wsValidTxCreate(request.resource.data))
          || (wsCashier(workspaceId) && wsValidPosTxCreate(request.resource.data));
        allow update: if wsWrite(workspaceId) && wsValidTxUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      match /bills/{billId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && wsValidBillCreate(request.resource.data);
        allow update: if wsWrite(workspaceId)
          && (isValidBillPayTransition(request.resource.data, resource.data)
            || wsValidBillUpdate(request.resource.data, resource.data));
        allow delete: if false;
      }
      match /subscriptions/{subscriptionId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && wsValidSubCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && wsValidSubUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      match /budgets/{budgetId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidBudgetCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && isValidBudgetUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      match /budget_allocations/{allocationId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidBudgetAllocationCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && isValidBudgetAllocationUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      match /invoices/{invoiceId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidInvoiceCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && isValidInvoiceUpdate(request.resource.data, resource.data);
        allow delete: if false;

        match /items/{itemId} {
          allow read: if wsRead(workspaceId);
          allow create: if wsWrite(workspaceId)
            && isValidInvoiceItem(request.resource.data)
            && request.resource.data.created_at == request.time
            && request.resource.data.updated_at == request.time
            && invoiceIsDraftAfterWriteWs(workspaceId, invoiceId);
          allow update: if wsWrite(workspaceId)
            && isValidInvoiceItem(request.resource.data)
            && request.resource.data.created_at == resource.data.created_at
            && request.resource.data.updated_at == request.time
            && invoiceIsDraftAfterWriteWs(workspaceId, invoiceId);
          allow delete: if wsWrite(workspaceId)
            && invoiceIsDraftAfterWriteWs(workspaceId, invoiceId);
        }
      }
      match /bank_accounts/{bankAccountId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidBankAccountCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && isValidBankAccountUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      match /vendors/{vendorId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidVendorCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && isValidVendorUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      match /bank_balance_snapshots/{snapshotId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidBankBalanceSnapshot(request.resource.data);
        allow update, delete: if false;
      }
      match /bank_statement_imports/{importId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId)
          && isValidBankStatementImport(request.resource.data)
          && request.resource.data.created_at == request.time
          && request.resource.data.updated_at == request.time;
        allow update: if wsWrite(workspaceId)
          && isValidBankStatementImport(request.resource.data)
          && request.resource.data.created_at == resource.data.created_at;
        allow delete: if false;

        match /rows/{rowId} {
          allow read: if wsRead(workspaceId);
          allow create: if wsWrite(workspaceId)
            && isValidBankStatementRow(request.resource.data)
            && request.resource.data.created_at == request.time;
          allow update: if wsWrite(workspaceId)
            && isValidBankStatementRow(request.resource.data)
            && request.resource.data.created_at == resource.data.created_at;
          allow delete: if false;
        }
      }
      match /documents/{documentId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId)
          && isValidDocumentMetadata(request.resource.data)
          && request.resource.data.created_at == request.time
          && request.resource.data.updated_at == request.time
          && request.resource.data.storage_path.matches('(users|workspaces)/.*/documents/.*');
        allow update: if wsWrite(workspaceId)
          && isValidDocumentMetadata(request.resource.data)
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.updated_at == request.time
          && request.resource.data.storage_path == resource.data.storage_path;
        allow delete: if false;
      }
      match /report_exports/{exportId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && wsValidReportExportCreate(request.resource.data);
        allow update, delete: if false;
      }
      match /accounting_mappings/{mappingId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId) && isValidAccountingMappingCreate(request.resource.data);
        allow update: if wsWrite(workspaceId) && isValidAccountingMappingUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }

      // Founder-facing category taxonomy over the Chart of Accounts (CoA Phase 1;
      // docs/data-model/chart-of-accounts.md). Names/codes only, never amounts.
      // Never deleted — deactivate via is_active. Validation kept lean on purpose
      // (rules eval budget); the client validator + audit trail compensate.
      match /business_categories/{categoryId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.default_account_code is string
          && request.resource.data.is_active is bool;
        allow delete: if false;
      }

      // --- ACCOUNTING KERNEL (double-entry) -------------------------------
      // Chart of Accounts. Archive via is_active; never hard-deleted. The code
      // field can never diverge from the doc id (codes are immutable).
      match /chart_of_accounts/{accountCode} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.code == accountCode
          && request.resource.data.name is string && request.resource.data.name.size() <= 120
          && request.resource.data.type in ['asset', 'liability', 'equity', 'revenue', 'expense']
          && request.resource.data.normal_balance in ['debit', 'credit'];
        allow delete: if false;
      }
      // Journals are immutable once posted: rules enforce Σdebit==Σcredit (>0) and
      // a non-closed period at create, and allow only the reversal-linkage field to
      // change afterward. Per-line sums cannot be verified in rules (the known
      // client-side-posting limitation — the reconcile script + Trial Balance
      // assertion are the compensating controls).
      match /journals/{journalId} {
        allow read: if wsRead(workspaceId);

        // Create. A manual DRAFT may be unbalanced and carries no journal_number
        // or period lock while it is being edited. A POSTED/reversal entry must be
        // balanced (>0), numbered, and target a non-closed period.
        allow create: if wsWrite(workspaceId)
          && request.resource.data.lines is list
          && request.resource.data.total_debit is number
          && request.resource.data.total_credit is number
          && request.resource.data.journal_type in ['system', 'manual']
          && (
            (request.resource.data.status == 'draft'
              && request.resource.data.journal_type == 'manual')
            || (request.resource.data.status in ['posted', 'reversal', 'reversed']
              && request.resource.data.total_debit == request.resource.data.total_credit
              && request.resource.data.total_debit > 0
              && request.resource.data.is_balanced == true
              && request.resource.data.journal_number is string
              && request.resource.data.journal_number.size() > 0
              && wsPeriodOpen(workspaceId, request.resource.data.period_key))
          );

        // Update. A draft may be edited by finance/accountant and may transition to
        // posted (re-asserting balance + number + open period). A posted/reversal/
        // reversed entry is immutable except for the reversal-linkage field.
        allow update: if wsWrite(workspaceId)
          && (
            (resource.data.status == 'draft'
              && (
                request.resource.data.status == 'draft'
                || (request.resource.data.status == 'posted'
                  && request.resource.data.total_debit == request.resource.data.total_credit
                  && request.resource.data.total_debit > 0
                  && request.resource.data.is_balanced == true
                  && request.resource.data.journal_number is string
                  && request.resource.data.journal_number.size() > 0
                  && wsPeriodOpen(workspaceId, request.resource.data.period_key))
              ))
            || (resource.data.status in ['posted', 'reversal', 'reversed']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reversed_by_journal_id']))
          );

        // Drafts can be discarded; posted entries are never deleted — corrections
        // happen through reversal journals only.
        allow delete: if wsWrite(workspaceId)
          && resource.data.status == 'draft';
      }
      // Running per-account/period balances (the trial-balance source). Written via
      // FieldValue.increment alongside each journal; field-validated only.
      match /ledger_balances/{balanceId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.account_code is string
          && request.resource.data.period_key is string
          && request.resource.data.debit_total is number && request.resource.data.debit_total >= 0
          && request.resource.data.credit_total is number && request.resource.data.credit_total >= 0;
        allow delete: if false;
      }
      // Per-dimension breakdown of ledger_balances. Doc id is
      // {period_key}__{account_code}__{dimension_id}; lines with no dimension use
      // the reserved '__unassigned__' key so the rows always sum to the
      // workspace-level row above. Written by FieldValue.increment in the same
      // batch as the journal (db-service _flushBalanceAcc). Validated field-wise
      // only, exactly like ledger_balances — kept to five inline checks because
      // this is on the posting hot path and the rules evaluation budget is real
      // (see the incidents recorded at lines 3367, 3526, 3546).
      match /ledger_balances_by_dim/{balanceId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.account_code is string
          && request.resource.data.period_key is string
          && request.resource.data.dimension_id is string
          && request.resource.data.debit_total is number && request.resource.data.debit_total >= 0
          && request.resource.data.credit_total is number && request.resource.data.credit_total >= 0;
        allow delete: if false;
      }
      // Outlets, branches and warehouses — the master behind dimension_id on
      // journal lines. One collection with a `type`, because an F&B outlet is
      // both a P&L unit and a stock location. Soft archive only: deleting one
      // would orphan journal lines that are immutable by rule.
      // Goods receipt: stock arriving before the supplier invoice does.
      // Posts GR-RECEIPT (Dr 1200 Inventory / Cr 2050 GRNI). `lines` is validated
      // in db-service, not here — rules cannot iterate an array cheaply and the
      // evaluation budget is real (incidents at 3367, 3526, 3546).
      // Never deleted: it carries an immutable journal. Correct by reversal.
      match /goods_receipts/{receiptId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.total_amount is number
          && request.resource.data.total_amount >= 0
          && request.resource.data.lines is list
          && request.resource.data.status in ['received', 'billed', 'reversed'];
        allow delete: if false;
      }
      // Stock count and waste. Posts STOCK-COUNT-COGS / STOCK-COUNT-GAIN /
      // STOCK-WASTE. `total_amount` is SIGNED — negative means stock left — so
      // it is deliberately not bounded at >= 0 the way a receipt total is.
      // Never deleted: it carries an immutable journal.
      match /stock_adjustments/{adjustmentId} {
        allow read: if wsRead(workspaceId);
        // Cashiers relieve stock for a SALE only — count/waste are how a
        // shortfall gets papered over, and are stock control, not a till action.
        allow create, update: if (wsWrite(workspaceId)
            || (wsCashier(workspaceId) && request.resource.data.adjustment_type == 'sale'))
          && request.resource.data.adjustment_type in ['count', 'waste', 'sale']
          && request.resource.data.total_amount is number
          && request.resource.data.lines is list
          && request.resource.data.status in ['posted', 'reversed'];
        allow delete: if false;
      }
      // Stock movements — the subledger 1200 Inventory must tie to.
      // `quantity` is SIGNED: positive in, negative out, so a sum over the
      // collection is the balance. Written in the same batch as the journal that
      // moved 1200, and never deleted, for the same reason journals are not:
      // deleting one would silently put the control account out of agreement
      // with the subledger, and nothing would report it.
      match /stock_movements/{movementId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId)
          && request.resource.data.item_id is string
          && request.resource.data.quantity is number
          && request.resource.data.amount is number
          && request.resource.data.period_key is string
          && request.resource.data.movement_type in ['receipt', 'issue', 'adjustment', 'count', 'waste', 'transfer'];
        allow update, delete: if false;
      }
      // Inventory master: ingredients, finished goods, and menu items.
      // `type` separates a stock item from a composite (recipe) one, and
      // `base_unit` is the unit every stored quantity is an integer count of.
      // Validation of units[] and conversion factors is done in
      // inventory-engine.js — rules stay at six inline checks because this is
      // master data written from a form, and the evaluation budget is real
      // (incidents at lines 3367, 3526, 3546). Soft archive only.
      match /items/{itemId} {
        // 'cashier' reads: the menu IS this collection, and nothing on an item is
        // sensitive (unit cost derives from stock_movements, which they can't
        // read). Writes stay finance+ — a till must not reprice the menu.
        allow read: if wsReadPos(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.type in ['stock', 'composite']
          && request.resource.data.base_unit is string
          && request.resource.data.base_unit.size() > 0
          && request.resource.data.status in ['active', 'archived'];
        allow delete: if false;
      }
      match /dimensions/{dimensionId} {
        // 'cashier' reads: a till must know its outlet, or the sale it posts
        // lands in "Unassigned" on /outlet-pnl.
        allow read: if wsReadPos(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.type in ['outlet', 'branch', 'warehouse']
          && request.resource.data.status in ['active', 'archived'];
        allow delete: if false;
      }
      // ---- Point of sale ----
      // Only two new collections: outlets are `dimensions`, the menu is `items`,
      // stock relief is `stock_adjustments`, revenue is `transactions`, per-outlet
      // P&L is `ledger_balances_by_dim`. docs/POS_IMPLEMENTATION_PLAN.md §7.
      //
      // Tables. Occupancy is NOT stored — it derives from whether an open order
      // references the table; a stored status eventually disagrees with reality.
      match /pos_tables/{tableId} {
        allow read: if wsReadPos(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 40
          && request.resource.data.dimension_id is string
          && request.resource.data.status in ['active', 'archived'];
        allow delete: if false;
      }
      // The cash drawer. A cashier opens, runs and closes their own shift — they
      // are the one holding the money, so withholding this would make the
      // feature unusable by the only role that needs it.
      match /pos_shifts/{shiftId} {
        allow read: if wsReadPos(workspaceId);
        allow create: if hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'cashier'])
          && wsValidPosShiftCreate(request.resource.data);
        allow update: if hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'cashier'])
          && wsValidPosShiftUpdate(request.resource.data, resource.data);
        allow delete: if false;
      }
      // Orders. Mutable while open, frozen once paid — correction is by refund,
      // never by edit, exactly as journals are corrected by reversal.
      match /pos_orders/{orderId} {
        allow read: if wsReadPos(workspaceId);
        allow create: if hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'cashier'])
          && wsValidPosOrderCreate(request.resource.data);
        // Refunds are finance+ only: handing money back out is the till-fraud
        // direction, withheld from cashiers by design (perms-service.js).
        allow update: if resource.data.status == 'paid'
          ? ((hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'cashier'])
                && wsValidPosOrderStamp(request.resource.data, resource.data))
              || (wsWrite(workspaceId)
                && wsValidPosOrderRefund(request.resource.data, resource.data)))
          : (hasRole(workspaceId, ['owner', 'admin', 'finance', 'accountant', 'cashier'])
              && wsValidPosOrderUpdate(request.resource.data, resource.data));
        allow delete: if false;
      }
      // Period lifecycle. Closing requires finance+; locking is owner/admin only.
      match /periods/{periodKey} {
        allow read: if wsRead(workspaceId);
        // Create (open or close): finance+; locking is owner/admin only.
        allow create: if request.resource.data.period_key is string
          && request.resource.data.status in ['open', 'closed', 'locked']
          && (request.resource.data.status != 'locked'
            ? wsWrite(workspaceId)
            : wsAdmin(workspaceId));
        // Update: REOPEN (closed/locked → open) and LOCK are owner/admin only;
        // other transitions (e.g. open → closed) are finance+.
        allow update: if request.resource.data.period_key is string
          && request.resource.data.status in ['open', 'closed', 'locked']
          && (
            ((resource.data.status == 'closed' || resource.data.status == 'locked') && request.resource.data.status == 'open')
              ? wsAdmin(workspaceId)
              : (request.resource.data.status == 'locked'
                ? wsAdmin(workspaceId)
                : wsWrite(workspaceId))
          );
        allow delete: if false;
      }
      // Per-year journal-number counters (doc id `journal-YYYY`). Reserved in a
      // transaction; `seq` only ever grows so a number is never reissued.
      // Journal numbering, plus per-outlet/per-day POS order numbers. A cashier
      // reaches ONLY the `pos-` counters — never `journal-*`, where a bumped
      // sequence would burn journal numbers and leave gaps in the audit trail.
      match /counters/{counterId} {
        allow read: if wsReadPos(workspaceId);
        allow create: if (wsWrite(workspaceId)
            || (wsCashier(workspaceId) && counterId.matches('^pos-.*')))
          && request.resource.data.seq is number
          && request.resource.data.seq >= 0;
        allow update: if (wsWrite(workspaceId)
            || (wsCashier(workspaceId) && counterId.matches('^pos-.*')))
          && request.resource.data.seq is number
          && request.resource.data.seq >= resource.data.seq;
        allow delete: if false;
      }

      // Nightly ledger-integrity reports, one doc per day
      // (netlify/functions/ledger-integrity-sweep.js). Written ONLY by the
      // scheduled sweep through the admin SDK, which bypasses rules — so clients
      // get read access and nothing else. A client-writable integrity report could
      // be used to mask the very drift it exists to surface.
      match /ledger_integrity_reports/{dayKey} {
        allow read: if wsRead(workspaceId);
        allow write: if false;
      }

      // --- TAX CENTER (Indonesia) -----------------------------------------
      // Derived layer over the accounting kernel; see
      // docs/INDONESIA_TAX_CENTER_ARCHITECTURE.md. Tax data is workspace-scoped and
      // amounts are raw integers. tax_transactions / tax_periods / tax_filings rules
      // are defined ahead of their data layer so later phases ship without a rules
      // redeploy. Reads: every member (incl. viewer). Writes: finance+/accountant,
      // except the irreversible filing step (owner/admin).
      match /company_tax_profile/{docId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.pkp_status in ['pkp', 'non_pkp']
          && (!('npwp' in request.resource.data) || request.resource.data.npwp == null || (request.resource.data.npwp is string && request.resource.data.npwp.size() <= 32))
          && (!('nik' in request.resource.data) || request.resource.data.nik == null || (request.resource.data.nik is string && request.resource.data.nik.size() <= 32))
          && (!('umkm_final' in request.resource.data) || request.resource.data.umkm_final is bool)
          && (!('default_ppn_rate' in request.resource.data) || (request.resource.data.default_ppn_rate is number && request.resource.data.default_ppn_rate >= 0 && request.resource.data.default_ppn_rate <= 100))
          && (!('tax_office_kpp' in request.resource.data) || request.resource.data.tax_office_kpp == null || (request.resource.data.tax_office_kpp is string && request.resource.data.tax_office_kpp.size() <= 120))
          && (!('business_classification' in request.resource.data) || request.resource.data.business_classification == null || (request.resource.data.business_classification is string && request.resource.data.business_classification.size() <= 120));
        allow delete: if false;
      }
      // Category/type → tax-code mappings. Soft-archive via status; hard delete is
      // owner/admin only.
      match /tax_mappings/{mappingId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.tax_code is string && request.resource.data.tax_code.size() <= 40
          && (!('tax_rate_percent' in request.resource.data) || (request.resource.data.tax_rate_percent is number && request.resource.data.tax_rate_percent >= 0 && request.resource.data.tax_rate_percent <= 100))
          && (!('status' in request.resource.data) || request.resource.data.status in ['active', 'archived']);
        allow delete: if wsAdmin(workspaceId);
      }
      // Tax lines emitted per business document (append-only). Raw-integer amounts;
      // only the reversal-linkage may change after creation.
      match /tax_transactions/{taxTxId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId)
          && request.resource.data.tax_code is string
          && request.resource.data.taxable_base is number && request.resource.data.taxable_base >= 0
          && request.resource.data.tax_amount is number && request.resource.data.tax_amount >= 0
          && request.resource.data.direction in ['output', 'input', 'withheld_by_us', 'withheld_by_other', 'final']
          && request.resource.data.period_key is string;
        allow update: if wsWrite(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reversed_by_tax_tx_id', 'updated_at']);
        allow delete: if false;
      }
      // Computed period summaries (cached from tax_transactions, like ledger_balances).
      match /tax_periods/{periodId} {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsWrite(workspaceId)
          && request.resource.data.status in ['open', 'computed', 'filed', 'amended', 'settled'];
        allow delete: if false;
      }
      // Filing records (append-only). Creating/marking a draft filing is finance+;
      // accept/reject/amend (the irreversible, outward-facing step) is owner/admin.
      match /tax_filings/{filingId} {
        allow read: if wsRead(workspaceId);
        allow create: if wsWrite(workspaceId)
          && request.resource.data.filing_type is string
          && request.resource.data.status in ['draft', 'filed', 'accepted', 'rejected', 'amended'];
        allow update: if wsAdmin(workspaceId);
        allow delete: if false;
      }

      // ---- Commerce Integration Platform (workspace-scoped, mostly server-written) ----
      // Marketplace connections + normalized commerce data synced by the
      // backend (Admin SDK, which bypasses these rules). Clients read; the ONLY
      // client write in the whole family is the owner/admin auto_post toggle on
      // commerce_accounts. Token material NEVER lives in these collections — it
      // is in the top-level deny-all commerce_credentials (see end of file).
      // See docs/COMMERCE_INTEGRATION_PHASE0_REVIEW.md (D1, D2, §4).
      match /commerce_accounts/{accountId} {
        allow read: if wsRead(workspaceId);
        allow create, delete: if false;
        allow update: if wsAdmin(workspaceId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['auto_post', 'updated_at'])
          && request.resource.data.auto_post is bool;
      }
      match /commerce_orders/{orderId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      match /commerce_transactions/{txId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      match /commerce_refunds/{refundId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      match /commerce_settlements/{settlementId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      match /commerce_payouts/{payoutId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      match /commerce_sync_jobs/{jobId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      match /commerce_sync_errors/{errorId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
      }
      // Webhook delivery log (payload summaries only, never raw payloads) —
      // operational detail, owner/admin only.
      match /commerce_webhook_logs/{logId} {
        allow read: if wsAdmin(workspaceId);
        allow create, update, delete: if false;
      }

      // ---- Invoice auto-email delivery (server-written; client reads only) ----
      // The delivery-status badge + attempts timeline in the invoice detail view
      // read these; only the Admin SDK (Netlify functions) writes them.
      match /invoice_email_jobs/{jobId} {
        allow read: if wsRead(workspaceId);
        allow create, update, delete: if false;
        match /attempts/{attemptId} {
          allow read: if wsRead(workspaceId);
          allow create, update, delete: if false;
        }
      }

      // ---- Invoice email branding/customization (member-read, owner/admin-write) ----
      match /settings/invoice_email {
        allow read: if wsRead(workspaceId);
        allow create, update: if wsAdmin(workspaceId)
          && isValidInvoiceEmailSettings(request.resource.data);
        allow delete: if false;
      }
    }

    // Reverse lookup: a user may read/write only their own pointer doc.
    match /user_workspaces/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- Commerce Integration secrets (SERVER-ONLY, explicit deny) ----
    // Encrypted marketplace OAuth tokens and the webhook shop→workspace lookup.
    // Deliberately TOP-LEVEL (not under workspaces/) so no future edit to the
    // workspace block can accidentally expose them, and deliberately explicit
    // (the catch-all below would already deny) so the intent is visible. Only
    // the Admin SDK (Netlify functions) touches these. NEVER weaken.
    match /commerce_credentials/{credentialId} {
      allow read, write: if false;
    }
    match /commerce_shop_directory/{shopKey} {
      allow read, write: if false;
    }

    // QR table token -> workspace. Admin SDK only, exactly like
    // commerce_shop_directory above: a guessed token cannot even confirm a
    // workspace exists, and the customer surface never touches Firestore.
    match /pos_table_directory/{tokenKey} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
