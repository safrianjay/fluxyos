rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasTrialStorageEntitlement(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId)/billing_subscription/current)
        && (
          firestore.get(/databases/(default)/documents/users/$(userId)/billing_subscription/current).data.plan_id == 'trial'
          || firestore.get(/databases/(default)/documents/users/$(userId)/billing_subscription/current).data.status in [
            'trialing',
            'awaiting_payment',
            'pending_verification',
            'payment_failed',
            'expired'
          ]
        );
    }

    function respectsTrialStorageSingleFileLimit(userId) {
      return !hasTrialStorageEntitlement(userId)
        || request.resource.size <= 5 * 1024 * 1024;
    }

    // Workspace membership for shared finance storage (documents, bank statements).
    // Mirrors firestore.rules isMember(): active member of the workspace. The
    // workspace id equals the owner's uid, so trial limits read the owner's billing.
    function isWorkspaceMember(workspaceId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // LEGACY. Pre-`documents` receipts. Read stays open to the owner so historical
    // attachments still render; writes are closed because the only uploader
    // (uploadReceipt) is gone — it wrote outside _scope(), so a teammate's file
    // landed outside the shared workspace tree, and it minted a public URL.
    // New uploads go to documents/ via uploadDocument.
    match /users/{userId}/receipts/{filename} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if false;
      allow delete: if false;
    }
    // KYC identity/business documents, uploaded during onboarding and reviewed in
    // the Internal Operations Console. USER-scoped on purpose: a workspace
    // teammate must never be able to read the owner's ID document, so this does
    // NOT use isWorkspaceMember like the finance paths below.
    //
    // No trial-storage entitlement check — these are uploaded BEFORE any
    // subscription exists (the trial is created only at KYC approval), so
    // hasTrialStorageEntitlement would read a doc that isn't there yet.
    //
    // The reviewer reads these through the Admin SDK (kyc-document-url function),
    // which bypasses rules — that is why there is no reviewer read rule here.
    match /users/{userId}/kyc/{docType}/{fileName} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if request.auth != null
                    && request.auth.uid == userId
                    && docType in ['identity', 'business']
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf'];
      allow delete: if false;
    }
    match /users/{userId}/documents/{documentId}/{fileName} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if request.auth != null
                    && request.auth.uid == userId
                    && respectsTrialStorageSingleFileLimit(userId)
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
      allow delete: if false;
    }
    match /users/{userId}/bank_statement_imports/{importId}/{fileName} {
      allow read:   if request.auth != null && request.auth.uid == userId;
      allow write:  if request.auth != null
                    && request.auth.uid == userId
                    && respectsTrialStorageSingleFileLimit(userId)
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType in [
                        'application/pdf',
                        'text/csv',
                        'application/csv',
                        'application/vnd.ms-excel',
                        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    ];
      allow delete: if false;
    }
    // Workspace-scoped finance storage (shared across team members). Mirrors the
    // user-scoped document / bank-statement rules above, gated by workspace
    // membership instead of uid ownership. See firestore.rules §workspaces.
    match /workspaces/{workspaceId}/documents/{documentId}/{fileName} {
      allow read:   if isWorkspaceMember(workspaceId);
      allow write:  if isWorkspaceMember(workspaceId)
                    && respectsTrialStorageSingleFileLimit(workspaceId)
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'application/pdf'];
      allow delete: if false;
    }
    // Product photos on the inventory master, shown on the POS menu card.
    //
    // A separate path from `documents` on purpose. A document is a RECORD — it
    // gets a Firestore row, counts against the plan's document-processing quota,
    // and is meant to be read once by a person or an extractor. A product photo
    // is a PROPERTY of an item: written once by whoever maintains the catalogue,
    // read on every till load by every cashier, and never processed. Filing it as
    // a document would burn the workspace's monthly extraction quota for a
    // thumbnail and put a stray row in the attachments list of nothing.
    //
    // `delete: if false` matches every other path here. An item is never deleted
    // either (docs/data-model/items.md §5), and replacing a photo writes a new
    // object — the old one is unreferenced, not removed, which keeps a mis-click
    // recoverable and costs a few KB.
    //
    // 2 MB, tighter than documents' 5 MB: this is a menu thumbnail rendered at
    // ~200px on a tablet, and the cost of a generous ceiling is paid on every
    // till load by the person least able to wait for it.
    match /workspaces/{workspaceId}/items/{itemId}/{fileName} {
      allow read:   if isWorkspaceMember(workspaceId);
      allow write:  if isWorkspaceMember(workspaceId)
                    && respectsTrialStorageSingleFileLimit(workspaceId)
                    && request.resource.size <= 2 * 1024 * 1024
                    && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow delete: if false;
    }
    match /workspaces/{workspaceId}/bank_statement_imports/{importId}/{fileName} {
      allow read:   if isWorkspaceMember(workspaceId);
      allow write:  if isWorkspaceMember(workspaceId)
                    && respectsTrialStorageSingleFileLimit(workspaceId)
                    && request.resource.size <= 10 * 1024 * 1024
                    && request.resource.contentType in [
                        'application/pdf',
                        'text/csv',
                        'application/csv',
                        'application/vnd.ms-excel',
                        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    ];
      allow delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
